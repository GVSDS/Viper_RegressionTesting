if x > 1 and x < 100:
    y = x * 2 + 1
elif x == 1:
    y = 1
else:
    y = 0
"""
    cmix_mod: Module | CPtr = parse(complex_mixed_src, pool)
    if cmix_mod is not None and cmix_mod.children is not None:
        cmix_cnt: sizet = cmix_mod.children.__len__()
