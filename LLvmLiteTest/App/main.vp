    testcheck.check(string.strstr(buf, "llvm.fptosi %0 : f64 to i32") is not None, "has 'llvm.fptosi %0 : f64 to i32'", "missing 'llvm.fptosi'")


# ============================================================
# 测试 16: Phi 节点
# ============================================================
def test_phi(pool: memhub.MemBuddy*):
    testcheck.section("Test 16: Phi Node")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_i32: mlirlite.LLVMType* = core.Int32()

    mod: mlirlite.Module* = mcore.NewModule("test_phi")
    func: mlirlite.Function* = mcore.CreateFunction(mod, "phi_test", ty_i32)
    entry: mlirlite.BasicBlock* = mcore.CreateBlock(func, "entry")
    then_blk: mlirlite.BasicBlock* = mcore.CreateBlock(func, "then")
    else_blk: mlirlite.BasicBlock* = mcore.CreateBlock(func, "else")
    merge: mlirlite.BasicBlock* = mcore.CreateBlock(func, "merge")
    builder: mlirlite.IRBuilder* = mcore.NewBuilder(func)

    # entry: br label %then
    mlirlite.position_at_end(builder, entry)
    mlirlite.build_br(builder, then_blk)

    # then: br label %merge
    mlirlite.position_at_end(builder, then_blk)
    v_1: mlirlite.Value* = mcore.ConstInt32(1)
    mlirlite.build_br(builder, merge)

    # else: br label %merge
    mlirlite.position_at_end(builder, else_blk)
    v_2: mlirlite.Value* = mcore.ConstInt32(2)
    mlirlite.build_br(builder, merge)

    # merge: %r = phi i32 [1, %then], [2, %else]; ret i32 %r
    mlirlite.position_at_end(builder, merge)
    inc1: mlirlite.PhiIncoming* = mlirlite.new_phi_incoming(pool, v_1, then_blk)
    inc2: mlirlite.PhiIncoming* = mlirlite.new_phi_incoming(pool, v_2, else_blk)
    inc1.Next = inc2
    v_r: mlirlite.Value* = mlirlite.build_phi(builder, ty_i32, inc1, 2)
    mlirlite.build_ret(builder, v_r)

    buf: str = pool.alloc(4096)
    buf[0] = 0
    mcore.PrintFunction(buf, 4096, func)
    testcheck.info(buf)

    # phi 已转为块参数：不再输出 phi 行，改为 ^merge(%…) + llvm.br ^merge(%…)
    testcheck.check(string.strstr(buf, "llvm.br ^merge(%c0 : i32)") is not None, "has 'llvm.br ^merge(%c0 : i32)'", "missing branch block operands")
    testcheck.check(string.strstr(buf, "^merge(%0: i32):") is not None, "has '^merge(%0: i32):'", "missing block arguments")
    testcheck.check(string.strstr(buf, "^then:") is not None, "has '^then:'", "missing '^then:'")
    testcheck.check(string.strstr(buf, "^else:") is not None, "has '^else:'", "missing '^else:'")
    testcheck.check(string.strstr(buf, " = phi ") is None, "phi 行不再输出", "phi line should not be emitted")


# ============================================================
# 测试 17: Switch
# ============================================================
def test_switch(pool: memhub.MemBuddy*):
    testcheck.section("Test 17: Switch")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_i32: mlirlite.LLVMType* = core.Int32()
    ty_void: mlirlite.LLVMType* = core.Void()

    mod: mlirlite.Module* = mcore.NewModule("test_switch")
    func: mlirlite.Function* = mcore.CreateFunction(mod, "switch_test", ty_void)
    mcore.AddParam(func, ty_i32, "%x")
    entry: mlirlite.BasicBlock* = mcore.CreateBlock(func, "entry")
    case0: mlirlite.BasicBlock* = mcore.CreateBlock(func, "case0")
    case1: mlirlite.BasicBlock* = mcore.CreateBlock(func, "case1")
    default_blk: mlirlite.BasicBlock* = mcore.CreateBlock(func, "default")
    builder: mlirlite.IRBuilder* = mcore.NewBuilder(func)

    # entry: switch i32 %x, label %default [i32 0, label %case0; i32 1, label %case1]
    mlirlite.position_at_end(builder, entry)
    v_x: mlirlite.Value* = mcore.SSAValue(ty_i32, "%x")
    v_0: mlirlite.Value* = mcore.ConstInt32(0)
    v_1: mlirlite.Value* = mcore.ConstInt32(1)
    c0: mlirlite.SwitchCase* = mlirlite.new_switch_case(pool, v_0, case0)
    c1: mlirlite.SwitchCase* = mlirlite.new_switch_case(pool, v_1, case1)
    c0.Next = c1
    mlirlite.build_switch(builder, v_x, default_blk, c0, 2)

    # case0/case1/default: ret void
    mlirlite.position_at_end(builder, case0)
    mlirlite.build_ret_void(builder)
    mlirlite.position_at_end(builder, case1)
    mlirlite.build_ret_void(builder)
    mlirlite.position_at_end(builder, default_blk)
    mlirlite.build_ret_void(builder)

    buf: str = pool.alloc(4096)
    buf[0] = 0
    mcore.PrintFunction(buf, 4096, func)
    testcheck.info(buf)

    testcheck.check(string.strstr(buf, "llvm.switch %x : i32, ^default [0: ^case0, 1: ^case1]") is not None, "has 'llvm.switch %x : i32, ^default [0: ^case0, 1: ^case1]'", "missing 'llvm.switch'")
    testcheck.check(string.strstr(buf, "^default:") is not None, "has '^default:'", "missing '^default:'")
    testcheck.check(string.strstr(buf, "^case0:") is not None, "has '^case0:'", "missing '^case0:'")


