    # atomicrmw add i32* %p, i32 1 monotonic
    v_r: mlirlite.Value* = mlirlite.build_atomicrmw(builder, mlirlite.ATOMIC_ADD,
                                                            v_p, v_1, mlirlite.ATOMIC_ORDER_MONOTONIC)
