# ============================================================
# 测试 19: 全局变量 (字符串常量 + 整数)
# ============================================================
def test_globals(pool: memhub.MemBuddy*):
    testcheck.section("Test 19: Global Variables")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_i32: mlirlite.LLVMType* = core.Int32()
    ty_void: mlirlite.LLVMType* = core.Void()

    mod: mlirlite.Module* = mcore.NewModule("test_globals")
    mlirlite.module_set_target(mod, "x86_64-pc-windows-gnu")

    # 字符串常量: @.str = private unnamed_addr constant [6 x i8] c"hello\00"
    mcore.CreateGlobalString(mod, ".str", "hello")

    # 整数全局变量: @counter = global i32 0
    mcore.CreateGlobalInt(mod, "counter", 32, 0)

    # 添加一个简单函数使模块非空
    func: mlirlite.Function* = mcore.CreateFunction(mod, "use_global", ty_void)
    entry: mlirlite.BasicBlock* = mcore.CreateBlock(func, "entry")
    builder: mlirlite.IRBuilder* = mcore.NewBuilder(func)
    mlirlite.position_at_end(builder, entry)
    mlirlite.build_ret_void(builder)

    buf: str = pool.alloc(8192)
    buf[0] = 0
    mcore.PrintModule(buf, 8192, mod)
    testcheck.info(buf)

    testcheck.check(string.strstr(buf, "llvm.mlir.global") is not None, "has 'llvm.mlir.global'", "missing 'llvm.mlir.global'")
    testcheck.check(string.strstr(buf, "private unnamed_addr constant") is not None,
                    "has 'private unnamed_addr constant'",
                    "missing 'private unnamed_addr constant'")
    testcheck.check(string.strstr(buf, "@\".str\"(") is not None, "has '@\".str\"('", "missing quoted string global")
    testcheck.check(string.strstr(buf, "hello\\00") is not None, "has 'hello\\00'", "missing string content")
    testcheck.check(string.strstr(buf, "@counter(0 : i32) : i32") is not None, "has '@counter(0 : i32) : i32'", "missing '@counter'")
    testcheck.check(string.strstr(buf, "llvm.mlir.global @counter") is not None, "has 'llvm.mlir.global @counter'", "missing integer global")


# ============================================================
# 测试 20: 函数与参数属性
# ============================================================
def test_attributes(pool: memhub.MemBuddy*):
    testcheck.section("Test 20: Function & Param Attributes")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_i32: mlirlite.LLVMType* = core.Int32()
    ty_i8ptr: mlirlite.LLVMType* = core.Ptr(core.Int8())

    mod: mlirlite.Module* = mcore.NewModule("test_attrs")
    func: mlirlite.Function* = mcore.CreateFunction(mod, "attr_test", ty_i32)

    # 参数 0: i32 noundef %x
    p0: mlirlite.Param* = mcore.AddParam(func, ty_i32, "%x")
    mcore.ParamSetAttrs(p0, "noundef")

    # 参数 1: i8* nocapture %p
    p1: mlirlite.Param* = mcore.AddParam(func, ty_i8ptr, "%p")
    mcore.ParamSetAttrs(p1, "nocapture")

    # 函数属性: nounwind
    mcore.FunctionSetAttrs(func, "nounwind")

    entry: mlirlite.BasicBlock* = mcore.CreateBlock(func, "entry")
    builder: mlirlite.IRBuilder* = mcore.NewBuilder(func)
    mlirlite.position_at_end(builder, entry)
    v_x: mlirlite.Value* = mcore.SSAValue(ty_i32, "%x")
    mlirlite.build_ret(builder, v_x)

    buf: str = pool.alloc(4096)
    buf[0] = 0
    mcore.PrintFunction(buf, 4096, func)
    testcheck.info(buf)

    # MLIR v1: 函数/参数属性（Attrs）记录但不渲染（见 includes/mlirlite/README.md §3.3）。
    # 故断言签名本身正确、且属性文本不出现（模型字段仍保留）。
    testcheck.check(string.strstr(buf, "llvm.func @attr_test(%x: i32, %p: !llvm.ptr) -> i32") is not None,
                    "has 'llvm.func @attr_test(%x: i32, %p: !llvm.ptr) -> i32'",
                    "missing attribute-test function signature")
    testcheck.check(string.strstr(buf, "noundef") is None,
                    "参数属性 'noundef' 记录但不渲染",
                    "param attr 'noundef' should not be rendered")
    testcheck.check(string.strstr(buf, "nocapture") is None,
                    "参数属性 'nocapture' 记录但不渲染",
                    "param attr 'nocapture' should not be rendered")
    testcheck.check(string.strstr(buf, ") nounwind") is None,
                    "函数属性 'nounwind' 记录但不渲染",
                    "func attr 'nounwind' should not be rendered")


