# --- Test 22: Inline ASM & Unreachable ---
def test_inline_asm_unreachable(pool: memhub.MemBuddy*):
    testcheck.section("Test 22: Inline ASM & Unreachable")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_void: mlirlite.LLVMType* = core.Void()

    mod: mlirlite.Module* = mcore.NewModule("test_asm")
    func: mlirlite.Function* = mcore.CreateFunction(mod, "asm_test", ty_void)
    entry: mlirlite.BasicBlock* = mcore.CreateBlock(func, "entry")
    trap_blk: mlirlite.BasicBlock* = mcore.CreateBlock(func, "trap")
    builder: mlirlite.IRBuilder* = mcore.NewBuilder(func)

    # entry: call void asm sideeffect "nop", ""(); br label %trap
    mlirlite.position_at_end(builder, entry)
    mlirlite.build_inline_asm(builder, ty_void, "nop", "", 1)
    mlirlite.build_br(builder, trap_blk)

    # trap: unreachable
    mlirlite.position_at_end(builder, trap_blk)
    mlirlite.build_unreachable(builder)

    buf: str = pool.alloc(4096)
    buf[0] = 0
    mcore.PrintFunction(buf, 4096, func)
    testcheck.info(buf)

    testcheck.check(string.strstr(buf, "llvm.inline_asm has_side_effects \"nop\", \"\" : () -> ()") is not None, "has 'llvm.inline_asm has_side_effects \"nop\", \"\" : () -> ()'", "missing 'llvm.inline_asm'")
    testcheck.check(string.strstr(buf, "unreachable") is not None, "has 'unreachable'", "missing 'unreachable'")
    testcheck.check(string.strstr(buf, "llvm.unreachable") is not None, "has 'llvm.unreachable'", "missing 'llvm.unreachable'")


# --- Test 23: Verify Valid Function ---
def test_verify_valid(pool: memhub.MemBuddy*):
    testcheck.section("Test 23: Verify Valid Function")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_i32: mlirlite.LLVMType* = core.Int32()

    mod: mlirlite.Module* = mcore.NewModule("verify_valid")
    func: mlirlite.Function* = mcore.CreateFunction(mod, "add", ty_i32)
    mcore.AddParam(func, ty_i32, "%a")
    mcore.AddParam(func, ty_i32, "%b")
    entry: mlirlite.BasicBlock* = mcore.CreateBlock(func, "entry")
    builder: mlirlite.IRBuilder* = mcore.NewBuilder(func)
    mlirlite.position_at_end(builder, entry)
    v_a: mlirlite.Value* = mcore.SSAValue(ty_i32, "%a")
    v_b: mlirlite.Value* = mcore.SSAValue(ty_i32, "%b")
    v_c: mlirlite.Value* = mlirlite.build_add(builder, v_a, v_b)
    mlirlite.build_ret(builder, v_c)

    result: mlirlite.VerifyResult* = mcore.NewVerifyResult(4096)
    err_count: int = mcore.VerifyFunction(func, result)
    testcheck.check(err_count == 0,
                    "valid add function: 0 errors",
                    "valid function should pass verification")
    testcheck.check(result.ErrorCode == mlirlite.VERIFY_OK,
                    "error code = VERIFY_OK",
                    "wrong error code for valid function")


# --- Test 24: Verify Missing Terminator ---
def test_verify_no_terminator(pool: memhub.MemBuddy*):
    testcheck.section("Test 24: Verify Missing Terminator")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_i32: mlirlite.LLVMType* = core.Int32()

    mod: mlirlite.Module* = mcore.NewModule("verify_noterm")
    func: mlirlite.Function* = mcore.CreateFunction(mod, "noterm", ty_i32)
    mcore.AddParam(func, ty_i32, "%a")
    entry: mlirlite.BasicBlock* = mcore.CreateBlock(func, "entry")
    builder: mlirlite.IRBuilder* = mcore.NewBuilder(func)
    mlirlite.position_at_end(builder, entry)
    v_a: mlirlite.Value* = mcore.SSAValue(ty_i32, "%a")
    mlirlite.build_add(builder, v_a, v_a)  # no ret

    result: mlirlite.VerifyResult* = mcore.NewVerifyResult(4096)
    err_count: int = mcore.VerifyFunction(func, result)
    testcheck.check(err_count > 0,
                    "missing terminator detected",
                    "should detect missing terminator")
    testcheck.check(result.ErrorCode == mlirlite.VERIFY_ERR_NO_TERMINATOR,
                    "error code = NO_TERMINATOR",
                    "wrong error code for missing terminator")


# --- Test 25: Verify Duplicate Definition ---
def test_verify_duplicate_def(pool: memhub.MemBuddy*):
    testcheck.section("Test 25: Verify Duplicate Definition")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_i32: mlirlite.LLVMType* = core.Int32()

    mod: mlirlite.Module* = mcore.NewModule("verify_dup")
    func: mlirlite.Function* = mcore.CreateFunction(mod, "dup_test", ty_i32)
    mcore.AddParam(func, ty_i32, "%a")
    entry: mlirlite.BasicBlock* = mcore.CreateBlock(func, "entry")
    builder: mlirlite.IRBuilder* = mcore.NewBuilder(func)
    mlirlite.position_at_end(builder, entry)
    v_a: mlirlite.Value* = mcore.SSAValue(ty_i32, "%a")
    v_c: mlirlite.Value* = mlirlite.build_add(builder, v_a, v_a)

    # manually append a duplicate definition line "%0 = add i32 %a, %a"
    dup_text: str = pool.alloc(64)
    string.strcpy(dup_text, "%0 = add i32 %a, %a")
    mlirlite.block_append_text(pool, entry, dup_text)

    mlirlite.build_ret(builder, v_c)

    result: mlirlite.VerifyResult* = mcore.NewVerifyResult(4096)
    err_count: int = mcore.VerifyFunction(func, result)
    testcheck.check(err_count > 0,
                    "duplicate definition detected",
                    "should detect duplicate definition")
    testcheck.check(result.ErrorCode == mlirlite.VERIFY_ERR_DUPLICATE_DEF,
                    "error code = DUPLICATE_DEF",
                    "wrong error code for duplicate def")


# --- Test 26: Verify Undefined Use ---
def test_verify_undef_use(pool: memhub.MemBuddy*):
    testcheck.section("Test 26: Verify Undefined Use")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_i32: mlirlite.LLVMType* = core.Int32()

    mod: mlirlite.Module* = mcore.NewModule("verify_undef")
    func: mlirlite.Function* = mcore.CreateFunction(mod, "undef_test", ty_i32)
    mcore.AddParam(func, ty_i32, "%a")
    entry: mlirlite.BasicBlock* = mcore.CreateBlock(func, "entry")

    # manually append a line with an undefined reference "%0 = add i32 %ghost, %a"
    line1: str = pool.alloc(64)
    string.strcpy(line1, "%0 = add i32 %ghost, %a")
    mlirlite.block_append_text(pool, entry, line1)

    # manually append terminator
    line2: str = pool.alloc(64)
    string.strcpy(line2, "ret i32 %0")
    mlirlite.block_append_text(pool, entry, line2)
    entry.IsTerminated = 1

    result: mlirlite.VerifyResult* = mcore.NewVerifyResult(4096)
    err_count: int = mcore.VerifyFunction(func, result)
    testcheck.check(err_count > 0,
                    "undefined use detected",
                    "should detect undefined use")
    testcheck.check(result.ErrorCode == mlirlite.VERIFY_ERR_UNDEFINED_USE,
                    "error code = UNDEFINED_USE",
                    "wrong error code for undefined use")


# --- Test 27: Verify Module (phi/labels) ---
def test_verify_module(pool: memhub.MemBuddy*):
    testcheck.section("Test 27: Verify Module (phi/labels)")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_i32: mlirlite.LLVMType* = core.Int32()

    mod: mlirlite.Module* = mcore.NewModule("verify_module")

    # function 1: simple add (valid)
    func1: mlirlite.Function* = mcore.CreateFunction(mod, "add", ty_i32)
    mcore.AddParam(func1, ty_i32, "%a")
    mcore.AddParam(func1, ty_i32, "%b")
    entry1: mlirlite.BasicBlock* = mcore.CreateBlock(func1, "entry")
    builder1: mlirlite.IRBuilder* = mcore.NewBuilder(func1)
    mlirlite.position_at_end(builder1, entry1)
    v_a: mlirlite.Value* = mcore.SSAValue(ty_i32, "%a")
    v_b: mlirlite.Value* = mcore.SSAValue(ty_i32, "%b")
    v_c: mlirlite.Value* = mlirlite.build_add(builder1, v_a, v_b)
    mlirlite.build_ret(builder1, v_c)

    # function 2: phi + branches (valid; block labels must not be flagged undefined)
    func2: mlirlite.Function* = mcore.CreateFunction(mod, "phi_test", ty_i32)
    f2_entry: mlirlite.BasicBlock* = mcore.CreateBlock(func2, "entry")
    then_blk: mlirlite.BasicBlock* = mcore.CreateBlock(func2, "then")
    else_blk: mlirlite.BasicBlock* = mcore.CreateBlock(func2, "else")
    merge: mlirlite.BasicBlock* = mcore.CreateBlock(func2, "merge")
    builder2: mlirlite.IRBuilder* = mcore.NewBuilder(func2)

    # entry: br label %then
    mlirlite.position_at_end(builder2, f2_entry)
    mlirlite.build_br(builder2, then_blk)

    # then: br label %merge
    mlirlite.position_at_end(builder2, then_blk)
    v_1: mlirlite.Value* = mcore.ConstInt32(1)
    mlirlite.build_br(builder2, merge)

    # else: br label %merge
    mlirlite.position_at_end(builder2, else_blk)
    v_2: mlirlite.Value* = mcore.ConstInt32(2)
    mlirlite.build_br(builder2, merge)

    # merge: %r = phi i32 [1, %then], [2, %else]; ret i32 %r
    mlirlite.position_at_end(builder2, merge)
    inc1: mlirlite.PhiIncoming* = mlirlite.new_phi_incoming(pool, v_1, then_blk)
    inc2: mlirlite.PhiIncoming* = mlirlite.new_phi_incoming(pool, v_2, else_blk)
    inc1.Next = inc2
    v_r: mlirlite.Value* = mlirlite.build_phi(builder2, ty_i32, inc1, 2)
    mlirlite.build_ret(builder2, v_r)

    result: mlirlite.VerifyResult* = mcore.NewVerifyResult(4096)
    err_count: int = mcore.VerifyModule(mod, result)
    testcheck.check(err_count == 0,
                    "module with phi/branches: 0 errors",
                    "valid module with phi should pass verification")
    testcheck.check(result.ErrorCode == mlirlite.VERIFY_OK,
                    "error code = VERIFY_OK",
                    "wrong error code for valid module")


def main() -> int:
    testcheck.begin("LLvmLiteTest: mlirlite 库（LLVM IR 生成）")

    # init pool
    pool_mem: bytes = stdlib.malloc(POOL_SIZE)
    if pool_mem is None:
        stdio.printf("FAIL: malloc for pool failed\n")
        return 1
    pool: memhub.MemBuddy* = memhub.MemBuddy(pool_mem, POOL_SIZE)
    if pool is None:
        stdio.printf("FAIL: memhub.MemBuddy init failed\n")
        return 1

    test_type_print(pool)
    test_value_print(pool)
    test_build_add(pool)
    test_build_if_else(pool)
    test_module_print(pool)
    test_array_type(pool)
    test_struct_type(pool)
    test_func_type(pool)
    test_declare(pool)
    test_float_types(pool)
    test_float_binops(pool)
    test_bitwise_ops(pool)
    test_fcmp(pool)
    test_casts(pool)
    test_fp_conversions(pool)
    test_phi(pool)
    test_switch(pool)
    test_select(pool)
    test_globals(pool)
    test_attributes(pool)
    test_atomic(pool)
    test_inline_asm_unreachable(pool)
    test_verify_valid(pool)
    test_verify_no_terminator(pool)
    test_verify_duplicate_def(pool)
    test_verify_undef_use(pool)
    test_verify_module(pool)

    return testcheck.end()
