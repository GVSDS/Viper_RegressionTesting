# ============================================================
# 测试 14: 类型转换 (zext, ptrtoint, inttoptr)
# ============================================================
def test_casts(pool: memhub.MemBuddy*):
    testcheck.section("Test 14: Casts (zext/ptrtoint/inttoptr)")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_i32: mlirlite.LLVMType* = core.Int32()
    ty_i64: mlirlite.LLVMType* = core.Int64()
    ty_i8: mlirlite.LLVMType* = core.Int8()
    ty_i8ptr: mlirlite.LLVMType* = core.Ptr(ty_i8)

    mod: mlirlite.Module* = mcore.NewModule("test_casts")
    func: mlirlite.Function* = mcore.CreateFunction(mod, "cast_test", ty_i64)
    mcore.AddParam(func, ty_i32, "%x")
    entry: mlirlite.BasicBlock* = mcore.CreateBlock(func, "entry")
    builder: mlirlite.IRBuilder* = mcore.NewBuilder(func)
    mlirlite.position_at_end(builder, entry)

    v_x: mlirlite.Value* = mcore.SSAValue(ty_i32, "%x")
    # zext i32 %x to i64
    v_ext: mlirlite.Value* = mlirlite.build_zext(builder, v_x, ty_i64)
    # ptrtoint i8* null to i64
    v_null: mlirlite.Value* = mcore.ConstNull(ty_i8ptr, "null")
    v_p2i: mlirlite.Value* = mlirlite.build_ptrtoint(builder, v_null, ty_i64)
    # inttoptr i64 %p2i to i8*
    v_i2p: mlirlite.Value* = mlirlite.build_inttoptr(builder, v_p2i, ty_i8ptr)
    # ret i64 %ext
    mlirlite.build_ret(builder, v_ext)

    buf: str = pool.alloc(4096)
    buf[0] = 0
    mcore.PrintFunction(buf, 4096, func)
    testcheck.info(buf)

    testcheck.check(string.strstr(buf, "llvm.zext %x : i32 to i64") is not None, "has 'llvm.zext %x : i32 to i64'", "missing 'llvm.zext'")
    testcheck.check(string.strstr(buf, "llvm.ptrtoint %c0 : !llvm.ptr to i64") is not None, "has 'llvm.ptrtoint %c0 : !llvm.ptr to i64'", "missing 'llvm.ptrtoint'")
    testcheck.check(string.strstr(buf, "llvm.inttoptr %1 : i64 to !llvm.ptr") is not None, "has 'llvm.inttoptr %1 : i64 to !llvm.ptr'", "missing 'llvm.inttoptr'")


