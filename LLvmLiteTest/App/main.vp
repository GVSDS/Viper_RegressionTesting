import stdio
import string
import stdlib
import memhub
import testcheck
import mlirlite


# 内存大小
# 单端 MLIR 后 mlirlite 渲染单次 PrintModule 需约 1 MiB 缩进缓冲 + 类型/初值
# 草稿，且本测试 27 个用例共享**同一个**池（不像 MLIRLiteTest 每用例切子池）
# ⇒ 512 KB 远不够（池耗尽）。与 MLIRLiteTest 主池同口径放大到 80 MiB。
define POOL_SIZE = 83886080  # 80MB


# ============================================================
# 测试 1: TypePrint 类型打印
# ============================================================
def test_type_print(pool: memhub.MemBuddy*):
    testcheck.section("Test 1: TypePrint")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    buf: str = pool.alloc(64)

    # i32
    ty_i32: mlirlite.LLVMType* = core.Int32()
    buf[0] = 0
    core.PrintType(buf, 64, ty_i32)
    testcheck.check(string.strcmp(buf, "i32") == 0,
                    "Int32 -> i32",
                    "Int32 fail")

    # 不透明指针: Ptr(Int32) -> !llvm.ptr
    ty_ptr: mlirlite.LLVMType* = core.Ptr(ty_i32)
    buf[0] = 0
    core.PrintType(buf, 64, ty_ptr)
    testcheck.check(string.strcmp(buf, "!llvm.ptr") == 0,
                    "Ptr(Int32) -> !llvm.ptr",
                    "Ptr fail")

    # Void -> none
    ty_void: mlirlite.LLVMType* = core.Void()
    buf[0] = 0
    core.PrintType(buf, 64, ty_void)
    testcheck.check(string.strcmp(buf, "none") == 0,
                    "Void -> none",
                    "Void fail")

    # i64
    ty_i64: mlirlite.LLVMType* = core.Int64()
    buf[0] = 0
    core.PrintType(buf, 64, ty_i64)
    testcheck.check(string.strcmp(buf, "i64") == 0,
                    "Int64 -> i64",
                    "Int64 fail")


# ============================================================
# 测试 2: ValuePrint 值打印
# ============================================================
def test_value_print(pool: memhub.MemBuddy*):
    testcheck.section("Test 2: ValuePrint")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    buf: str = pool.alloc(64)

    ty_i32: mlirlite.LLVMType* = core.Int32()

    # 常量 42 -> "42 : i32"（MLIR attribute 文本形态）
    val42: mlirlite.Value* = mcore.ConstInt32(42)
    buf[0] = 0
    mcore.PrintValue(buf, 64, val42)
    testcheck.check(string.strcmp(buf, "42 : i32") == 0,
                    "ConstInt(42) -> '42 : i32'",
                    "ConstInt fail")

    # SSA 值 %0 -> "%0"（MLIR 操作数不带类型）
    name_ssa: str = pool.alloc(16)
    string.strcpy(name_ssa, "%0")
    val_ssa: mlirlite.Value* = mcore.SSAValue(ty_i32, name_ssa)
    buf[0] = 0
    mcore.PrintValue(buf, 64, val_ssa)
    testcheck.check(string.strcmp(buf, "%0") == 0,
                    "SSAValue(%0) -> '%0'",
                    "SSAValue fail")


# ============================================================
# 测试 3: 构建 add 函数
# llvm.func @add(%a: i32, %b: i32) -> i32 {
#   %0 = llvm.add %a, %b : i32
#   llvm.return %0 : i32
# }
# ============================================================
def test_build_add(pool: memhub.MemBuddy*):
    testcheck.section("Test 3: build_add function")

    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_i32: mlirlite.LLVMType* = core.Int32()

    # 创建模块 + 函数
    mod: mlirlite.Module* = mcore.NewModule("test_add")
    func: mlirlite.Function* = mcore.CreateFunction(mod, "add", ty_i32)

    # 添加参数
    mcore.AddParam(func, ty_i32, "%a")
    mcore.AddParam(func, ty_i32, "%b")

    # 创建 entry 块
    entry: mlirlite.BasicBlock* = mcore.CreateBlock(func, "entry")

    # 创建 builder
    builder: mlirlite.IRBuilder* = mcore.NewBuilder(func)
    mlirlite.position_at_end(builder, entry)

    # 为参数创建 Value 包装
    v_a: mlirlite.Value* = mcore.SSAValue(ty_i32, "%a")
    v_b: mlirlite.Value* = mcore.SSAValue(ty_i32, "%b")

    # %0 = add i32 %a, %b
    v_c: mlirlite.Value* = mlirlite.build_add(builder, v_a, v_b)

    # ret i32 %0
    mlirlite.build_ret(builder, v_c)

    # 打印函数
    buf: str = pool.alloc(4096)
    buf[0] = 0
    mcore.PrintFunction(buf, 4096, func)
    testcheck.info(buf)

    # 验证关键内容
    testcheck.check(string.strstr(buf, "llvm.add %a, %b : i32") is not None,
                    "contains 'llvm.add %a, %b : i32'",
                    "missing 'llvm.add'")
    testcheck.check(string.strstr(buf, "llvm.return") is not None,
                    "contains 'llvm.return'",
                    "missing 'llvm.return'")
    testcheck.check(string.strstr(buf, "llvm.func @add(%a: i32, %b: i32) -> i32") is not None,
                    "contains 'llvm.func @add(%a: i32, %b: i32) -> i32'",
                    "missing function definition")


# ============================================================
# 测试 4: 构建 if-then-else 函数（max）
# llvm.func @max(%a: i32, %b: i32) -> i32 {
#   %0 = llvm.icmp "sgt" %a, %b : i32
#   llvm.cond_br %0, ^then, ^else
# ^then:
#   llvm.return %a : i32
# ^else:
#   llvm.return %b : i32
# }
# ============================================================
def test_build_if_else(pool: memhub.MemBuddy*):
    testcheck.section("Test 4: build if-then-else (max)")

    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_i32: mlirlite.LLVMType* = core.Int32()

    mod: mlirlite.Module* = mcore.NewModule("test_max")
    func: mlirlite.Function* = mcore.CreateFunction(mod, "max", ty_i32)
    mcore.AddParam(func, ty_i32, "%a")
    mcore.AddParam(func, ty_i32, "%b")

    entry:    mlirlite.BasicBlock* = mcore.CreateBlock(func, "entry")
    then_blk: mlirlite.BasicBlock* = mcore.CreateBlock(func, "then")
    else_blk: mlirlite.BasicBlock* = mcore.CreateBlock(func, "else")

    builder: mlirlite.IRBuilder* = mcore.NewBuilder(func)

    # entry: %0 = icmp sgt i32 %a, %b; br i1 %0, label %then, label %else
    mlirlite.position_at_end(builder, entry)
    v_a: mlirlite.Value* = mcore.SSAValue(ty_i32, "%a")
    v_b: mlirlite.Value* = mcore.SSAValue(ty_i32, "%b")
    v_cond: mlirlite.Value* = mlirlite.build_icmp(builder, mlirlite.ICMP_SGT, v_a, v_b)
    mlirlite.build_cond_br(builder, v_cond, then_blk, else_blk)

    # then: ret i32 %a
    mlirlite.position_at_end(builder, then_blk)
    mlirlite.build_ret(builder, v_a)

    # else: ret i32 %b
    mlirlite.position_at_end(builder, else_blk)
    mlirlite.build_ret(builder, v_b)

    # 打印函数
    buf: str = pool.alloc(4096)
    buf[0] = 0
    mcore.PrintFunction(buf, 4096, func)
    testcheck.info(buf)

    # 验证关键内容
    testcheck.check(string.strstr(buf, "llvm.icmp \"sgt\"") is not None,
                    "contains 'llvm.icmp \"sgt\"'",
                    "missing 'llvm.icmp \"sgt\"'")
    testcheck.check(string.strstr(buf, "llvm.cond_br") is not None,
                    "contains 'llvm.cond_br'",
                    "missing 'llvm.cond_br'")
    testcheck.check(string.strstr(buf, "^then:") is not None,
                    "contains '^then:'",
                    "missing block label '^then:'")
    testcheck.check(string.strstr(buf, "^else:") is not None,
                    "contains '^else:'",
                    "missing block label '^else:'")


# ============================================================
# 测试 5: 完整模块 ModulePrint
# ============================================================
def test_module_print(pool: memhub.MemBuddy*):
    testcheck.section("Test 5: ModulePrint")

    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_i32: mlirlite.LLVMType* = core.Int32()
    ty_void: mlirlite.LLVMType* = core.Void()

    # 创建模块
    mod: mlirlite.Module* = mcore.NewModule("test_module")
    mlirlite.module_set_target(mod, "x86_64-pc-windows-gnu")
    mlirlite.module_set_datalayout(mod, "e-m:w-p270:32:32")

    # 函数 1: add
    func_add: mlirlite.Function* = mcore.CreateFunction(mod, "add", ty_i32)
    mcore.AddParam(func_add, ty_i32, "%a")
    mcore.AddParam(func_add, ty_i32, "%b")
    entry1: mlirlite.BasicBlock* = mcore.CreateBlock(func_add, "entry")
    builder1: mlirlite.IRBuilder* = mcore.NewBuilder(func_add)
    mlirlite.position_at_end(builder1, entry1)
    v_a1: mlirlite.Value* = mcore.SSAValue(ty_i32, "%a")
    v_b1: mlirlite.Value* = mcore.SSAValue(ty_i32, "%b")
    v_sum: mlirlite.Value* = mlirlite.build_add(builder1, v_a1, v_b1)
    mlirlite.build_ret(builder1, v_sum)

    # 函数 2: void 函数
    func_void: mlirlite.Function* = mcore.CreateFunction(mod, "noop", ty_void)
    entry2: mlirlite.BasicBlock* = mcore.CreateBlock(func_void, "entry")
    builder2: mlirlite.IRBuilder* = mcore.NewBuilder(func_void)
    mlirlite.position_at_end(builder2, entry2)
    mlirlite.build_ret_void(builder2)

    # 打印模块
    buf: str = pool.alloc(8192)
    buf[0] = 0
    mcore.PrintModule(buf, 8192, mod)
    testcheck.info(buf)

    # 验证关键内容
    testcheck.check(string.strstr(buf, "module {") is not None,
                    "contains 'module {'",
                    "missing 'module {'")
    testcheck.check(string.strstr(buf, "target triple") is not None,
                    "contains 'target triple'（MLIR 只在注释里标注）",
                    "missing 'target triple'")
    testcheck.check(string.strstr(buf, "llvm.func @add") is not None,
                    "contains 'llvm.func @add'",
                    "missing add function")
    testcheck.check(string.strstr(buf, "llvm.func @noop()") is not None,
                    "contains 'llvm.func @noop()'（void 返回省略 -> ty）",
                    "missing noop function")
    testcheck.check(string.strstr(buf, "llvm.return") is not None,
                    "contains 'llvm.return'",
                    "missing 'llvm.return'")


# ============================================================
# 测试 6: 数组类型打印
# ============================================================
def test_array_type(pool: memhub.MemBuddy*):
    testcheck.section("Test 6: ArrayType")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    buf: str = pool.alloc(128)

    # [4 x i32] -> !llvm.array<4 x i32>
    ty_i32: mlirlite.LLVMType* = core.Int32()
    ty_arr: mlirlite.LLVMType* = core.Array(ty_i32, 4)
    buf[0] = 0
    core.PrintType(buf, 128, ty_arr)
    testcheck.check(string.strcmp(buf, "!llvm.array<4 x i32>") == 0,
                    "Array(i32,4) -> !llvm.array<4 x i32>",
                    "Array fail")

    # [2 x [3 x i8]] -> !llvm.array<2 x !llvm.array<3 x i8>>
    ty_i8: mlirlite.LLVMType* = core.Int8()
    ty_inner: mlirlite.LLVMType* = core.Array(ty_i8, 3)
    ty_nested: mlirlite.LLVMType* = core.Array(ty_inner, 2)
    buf[0] = 0
    core.PrintType(buf, 128, ty_nested)
    testcheck.check(string.strcmp(buf, "!llvm.array<2 x !llvm.array<3 x i8>>") == 0,
                    "nested array -> !llvm.array<2 x !llvm.array<3 x i8>>",
                    "nested array fail")


# ============================================================
# 测试 7: 结构体类型打印
# ============================================================
def test_struct_type(pool: memhub.MemBuddy*):
    testcheck.section("Test 7: StructType")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    buf: str = pool.alloc(128)

    ty_i32: mlirlite.LLVMType* = core.Int32()
    ty_i8: mlirlite.LLVMType* = core.Int8()
    ty_i8ptr: mlirlite.LLVMType* = core.Ptr(ty_i8)

    # {i32, i8*} -> !llvm.struct<(i32, !llvm.ptr)>
    n1: mlirlite.ParamNode* = core.NewParamNode(ty_i32)
    n2: mlirlite.ParamNode* = core.NewParamNode(ty_i8ptr)
    head: mlirlite.ParamNode* = core.ParamListAppend(None, None, n1)
    core.ParamListAppend(head, n1, n2)
    ty_struct: mlirlite.LLVMType* = core.Struct(head, 2)
    buf[0] = 0
    core.PrintType(buf, 128, ty_struct)
    testcheck.check(string.strcmp(buf, "!llvm.struct<(i32, !llvm.ptr)>") == 0,
                    "struct {i32, i8*} -> !llvm.struct<(i32, !llvm.ptr)>",
                    "struct fail")

    # 空结构体 -> !llvm.struct<()>
    ty_empty: mlirlite.LLVMType* = core.Struct(None, 0)
    buf[0] = 0
    core.PrintType(buf, 128, ty_empty)
    testcheck.check(string.strcmp(buf, "!llvm.struct<()>") == 0,
                    "empty struct -> !llvm.struct<()>",
                    "empty struct fail")


# ============================================================
# 测试 8: 函数类型打印
# ============================================================
def test_func_type(pool: memhub.MemBuddy*):
    testcheck.section("Test 8: FuncType")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    buf: str = pool.alloc(128)

    ty_i32: mlirlite.LLVMType* = core.Int32()
    ty_i8: mlirlite.LLVMType* = core.Int8()
    ty_i8ptr: mlirlite.LLVMType* = core.Ptr(ty_i8)

    # i32 (i32, i8*) -> !llvm.func<i32 (i32, !llvm.ptr)>
    n1: mlirlite.ParamNode* = core.NewParamNode(ty_i32)
    n2: mlirlite.ParamNode* = core.NewParamNode(ty_i8ptr)
    head: mlirlite.ParamNode* = core.ParamListAppend(None, None, n1)
    core.ParamListAppend(head, n1, n2)
    ty_func: mlirlite.LLVMType* = core.Func(ty_i32, head, 2)
    buf[0] = 0
    core.PrintType(buf, 128, ty_func)
    testcheck.check(string.strcmp(buf, "!llvm.func<i32 (i32, !llvm.ptr)>") == 0,
                    "func type -> !llvm.func<i32 (i32, !llvm.ptr)>",
                    "func type fail")

    # void () -> !llvm.func<none ()> — 无参数 void 函数类型
    ty_void: mlirlite.LLVMType* = core.Void()
    ty_func_void: mlirlite.LLVMType* = core.Func(ty_void, None, 0)
    buf[0] = 0
    core.PrintType(buf, 128, ty_func_void)
    testcheck.check(string.strcmp(buf, "!llvm.func<none ()>") == 0,
                    "void func -> !llvm.func<none ()>",
                    "void func fail")


# ============================================================
# 测试 9: 声明系统（declare vs define）
# ============================================================
def test_declare(pool: memhub.MemBuddy*):
    testcheck.section("Test 9: Declare vs Define")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_i32: mlirlite.LLVMType* = core.Int32()

    mod: mlirlite.Module* = mcore.NewModule("test_declare")

    # declare i32 @extern_func(i32)
    func_decl: mlirlite.Function* = mcore.CreateDeclare(mod, "extern_func", ty_i32)
    mcore.AddParam(func_decl, ty_i32, "%x")

    # define i32 @defined_func(i32) { entry: ret i32 %x }
    func_def: mlirlite.Function* = mcore.CreateFunction(mod, "defined_func", ty_i32)
    mcore.AddParam(func_def, ty_i32, "%x")
    entry: mlirlite.BasicBlock* = mcore.CreateBlock(func_def, "entry")
    builder: mlirlite.IRBuilder* = mcore.NewBuilder(func_def)
    mlirlite.position_at_end(builder, entry)
    v_x: mlirlite.Value* = mcore.SSAValue(ty_i32, "%x")
    mlirlite.build_ret(builder, v_x)

    buf: str = pool.alloc(4096)
    buf[0] = 0
    mcore.PrintModule(buf, 4096, mod)
    testcheck.info(buf)

    testcheck.check(string.strstr(buf, "llvm.func @extern_func(%x: i32) -> i32") is not None,
                    "contains declare 'llvm.func @extern_func(%x: i32) -> i32'",
                    "missing declare")
    testcheck.check(string.strstr(buf, "llvm.func @defined_func(%x: i32) -> i32") is not None,
                    "contains define 'llvm.func @defined_func(%x: i32) -> i32'",
                    "missing define")
    testcheck.check(string.strstr(buf, "llvm.func @extern_func(%x: i32) -> i32 {") is None,
                    "declare 无函数体（不出现 '{'）",
                    "declare missing param")
    testcheck.check(string.strstr(buf, "llvm.return %x : i32") is not None,
                    "define has body 'llvm.return %x : i32'",
                    "define missing body")


# ============================================================
# 测试 10: 浮点类型与 ConstFloat
# ============================================================
def test_float_types(pool: memhub.MemBuddy*):
    testcheck.section("Test 10: Float Types & ConstFloat")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    buf: str = pool.alloc(128)

    # half -> f16
    ty_half: mlirlite.LLVMType* = core.Half()
    buf[0] = 0
    core.PrintType(buf, 128, ty_half)
    testcheck.check(string.strcmp(buf, "f16") == 0,
                    "Half -> f16",
                    "Half fail")

    # float -> f32
    ty_float: mlirlite.LLVMType* = core.Float()
    buf[0] = 0
    core.PrintType(buf, 128, ty_float)
    testcheck.check(string.strcmp(buf, "f32") == 0,
                    "Float -> f32",
                    "Float fail")

    # double -> f64
    ty_double: mlirlite.LLVMType* = core.Double()
    buf[0] = 0
    core.PrintType(buf, 128, ty_double)
    testcheck.check(string.strcmp(buf, "f64") == 0,
                    "Double -> f64",
                    "Double fail")

    # fp128 -> f128
    ty_fp128: mlirlite.LLVMType* = core.FP128()
    buf[0] = 0
    core.PrintType(buf, 128, ty_fp128)
    testcheck.check(string.strcmp(buf, "f128") == 0,
                    "FP128 -> f128",
                    "FP128 fail")

    # ConstFloat(3.14) -> "0x40091EB851EB851F : f64"
    # （位模式无精度损失；类型注解为 MLIR 形态 f64）
    val_pi: mlirlite.Value* = mcore.ConstFloat(ty_double, 3.14)
    buf[0] = 0
    mcore.PrintValue(buf, 128, val_pi)
    testcheck.check(string.strstr(buf, " : f64") is not None,
                    "ConstFloat has MLIR type ' : f64'",
                    "ConstFloat missing type")
    testcheck.check(string.strstr(buf, "0x") is not None,
                    "ConstFloat has hex bit pattern",
                    "ConstFloat missing hex pattern")


# ============================================================
# 测试 11: 浮点二元运算
# ============================================================
def test_float_binops(pool: memhub.MemBuddy*):
    testcheck.section("Test 11: Float Binary Ops")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_double: mlirlite.LLVMType* = core.Double()

    mod: mlirlite.Module* = mcore.NewModule("test_fadd")
    func: mlirlite.Function* = mcore.CreateFunction(mod, "fadd", ty_double)
    mcore.AddParam(func, ty_double, "%a")
    mcore.AddParam(func, ty_double, "%b")
    entry: mlirlite.BasicBlock* = mcore.CreateBlock(func, "entry")
    builder: mlirlite.IRBuilder* = mcore.NewBuilder(func)
    mlirlite.position_at_end(builder, entry)

    v_a: mlirlite.Value* = mcore.SSAValue(ty_double, "%a")
    v_b: mlirlite.Value* = mcore.SSAValue(ty_double, "%b")
    v_c: mlirlite.Value* = mlirlite.build_fadd(builder, v_a, v_b)
    mlirlite.build_ret(builder, v_c)

    buf: str = pool.alloc(4096)
    buf[0] = 0
    mcore.PrintFunction(buf, 4096, func)
    testcheck.info(buf)

    testcheck.check(string.strstr(buf, "llvm.fadd %a, %b : f64") is not None,
                    "contains 'llvm.fadd %a, %b : f64'",
                    "missing 'llvm.fadd'")
    testcheck.check(string.strstr(buf, "llvm.return %0 : f64") is not None,
                    "contains 'llvm.return %0 : f64'",
                    "missing 'llvm.return'")


# ============================================================
# 测试 12: 位运算与移位
# ============================================================
def test_bitwise_ops(pool: memhub.MemBuddy*):
    testcheck.section("Test 12: Bitwise & Shift Ops")
    core: mlirlite.LLVMTypeCore* = mlirlite.LLVMTypeCore(pool)
    mcore: mlirlite.LLVMModuleCore* = mlirlite.LLVMModuleCore(pool)
    ty_i32: mlirlite.LLVMType* = core.Int32()

    mod: mlirlite.Module* = mcore.NewModule("test_bitops")
    func: mlirlite.Function* = mcore.CreateFunction(mod, "bitops", ty_i32)
    mcore.AddParam(func, ty_i32, "%a")
    mcore.AddParam(func, ty_i32, "%b")
    entry: mlirlite.BasicBlock* = mcore.CreateBlock(func, "entry")
    builder: mlirlite.IRBuilder* = mcore.NewBuilder(func)
    mlirlite.position_at_end(builder, entry)

    v_a: mlirlite.Value* = mcore.SSAValue(ty_i32, "%a")
    v_b: mlirlite.Value* = mcore.SSAValue(ty_i32, "%b")

    # and -> or -> xor -> shl -> ret
    v_and: mlirlite.Value* = mlirlite.build_and(builder, v_a, v_b)
    v_or: mlirlite.Value* = mlirlite.build_or(builder, v_and, v_b)
    v_xor: mlirlite.Value* = mlirlite.build_xor(builder, v_or, v_a)
    v_shl: mlirlite.Value* = mlirlite.build_shl(builder, v_xor, v_b)
    mlirlite.build_ret(builder, v_shl)

    buf: str = pool.alloc(4096)
    buf[0] = 0
    mcore.PrintFunction(buf, 4096, func)
    testcheck.info(buf)

    testcheck.check(string.strstr(buf, "llvm.and %a, %b : i32") is not None, "has 'llvm.and %a, %b : i32'", "missing 'llvm.and'")
    testcheck.check(string.strstr(buf, "llvm.or %0, %b : i32") is not None, "has 'llvm.or %0, %b : i32'", "missing 'llvm.or'")
    testcheck.check(string.strstr(buf, "llvm.xor %1, %a : i32") is not None, "has 'llvm.xor %1, %a : i32'", "missing 'llvm.xor'")
    testcheck.check(string.strstr(buf, "llvm.shl %2, %b : i32") is not None, "has 'llvm.shl %2, %b : i32'", "missing 'llvm.shl'")


