from stdint import *
import vipersimd
import numpy
from stdio import printf
from stdlib import calloc
import memhub
import testcheck


# Global memory pool
arena: uint8* = None
pool: memhub.MemPool* = None

# External function: clock() for performance timing
extern def clock() -> long

define CLOCK_PER_SEC = 1000


# 1. AVX2 double4 correctness tests

def test_avx2_add_sub_mul_div():
    testcheck.section("AVX2 add/sub/mul/div 4d")
    a: numpy.ndarray[double]* = numpy.zeros(pool, 4)
    a.data[0] = double(1.0)
    a.data[1] = double(2.0)
    a.data[2] = double(3.0)
    a.data[3] = double(4.0)

    b: numpy.ndarray[double]* = numpy.zeros(pool, 4)
    b.data[0] = double(5.0)
    b.data[1] = double(6.0)
    b.data[2] = double(7.0)
    b.data[3] = double(8.0)

    out: numpy.ndarray[double]* = numpy.zeros(pool, 4)

    # add
    vipersimd.simd_add4d(a.data, b.data, out.data)
    testcheck.check(out.data[0] == double(6.0), "add[0]==6", "add[0]==6")
    testcheck.check(out.data[1] == double(8.0), "add[1]==8", "add[1]==8")
    testcheck.check(out.data[2] == double(10.0), "add[2]==10", "add[2]==10")
    testcheck.check(out.data[3] == double(12.0), "add[3]==12", "add[3]==12")

    # sub
    vipersimd.simd_sub4d(a.data, b.data, out.data)
    testcheck.check(out.data[0] == double(-4.0), "sub[0]==-4", "sub[0]==-4")
    testcheck.check(out.data[3] == double(-4.0), "sub[3]==-4", "sub[3]==-4")

    # mul
    vipersimd.simd_mul4d(a.data, b.data, out.data)
    testcheck.check(out.data[0] == double(5.0), "mul[0]==5", "mul[0]==5")
    testcheck.check(out.data[1] == double(12.0), "mul[1]==12", "mul[1]==12")
    testcheck.check(out.data[2] == double(21.0), "mul[2]==21", "mul[2]==21")
    testcheck.check(out.data[3] == double(32.0), "mul[3]==32", "mul[3]==32")

    # div
    vipersimd.simd_div4d(b.data, a.data, out.data)
    testcheck.check(out.data[0] == double(5.0), "div[0]==5", "div[0]==5")
    testcheck.check(out.data[1] == double(3.0), "div[1]==3", "div[1]==3")

    a.delete()
    b.delete()
    out.delete()


def test_avx2_neg_abs_sqrt():
    testcheck.section("AVX2 neg/abs/sqrt 4d")
    a: numpy.ndarray[double]* = numpy.zeros(pool, 4)
    a.data[0] = double(1.0)
    a.data[1] = double(-4.0)
    a.data[2] = double(9.0)
    a.data[3] = double(-16.0)

    out: numpy.ndarray[double]* = numpy.zeros(pool, 4)

    # neg
    vipersimd.simd_neg4d(a.data, out.data)
    testcheck.check(out.data[0] == double(-1.0), "neg[0]==-1", "neg[0]==-1")
    testcheck.check(out.data[1] == double(4.0), "neg[1]==4", "neg[1]==4")
    testcheck.check(out.data[2] == double(-9.0), "neg[2]==-9", "neg[2]==-9")
    testcheck.check(out.data[3] == double(16.0), "neg[3]==16", "neg[3]==16")

    # abs
    vipersimd.simd_abs4d(a.data, out.data)
    testcheck.check(out.data[0] == double(1.0), "abs[0]==1", "abs[0]==1")
    testcheck.check(out.data[1] == double(4.0), "abs[1]==4", "abs[1]==4")
    testcheck.check(out.data[2] == double(9.0), "abs[2]==9", "abs[2]==9")
    testcheck.check(out.data[3] == double(16.0), "abs[3]==16", "abs[3]==16")

    # sqrt
    vipersimd.simd_sqrt4d(out.data, out.data)
    testcheck.check(out.data[0] == double(1.0), "sqrt[0]==1", "sqrt[0]==1")
    testcheck.check(out.data[1] == double(2.0), "sqrt[1]==2", "sqrt[1]==2")
    testcheck.check(out.data[2] == double(3.0), "sqrt[2]==3", "sqrt[2]==3")
    testcheck.check(out.data[3] == double(4.0), "sqrt[3]==4", "sqrt[3]==4")

    a.delete()
    out.delete()


def test_avx2_min_max():
    testcheck.section("AVX2 min/max 4d")
    a: numpy.ndarray[double]* = numpy.zeros(pool, 4)
    a.data[0] = double(1.0)
    a.data[1] = double(8.0)
    a.data[2] = double(3.0)
    a.data[3] = double(6.0)

    b: numpy.ndarray[double]* = numpy.zeros(pool, 4)
    b.data[0] = double(5.0)
    b.data[1] = double(2.0)
    b.data[2] = double(7.0)
    b.data[3] = double(4.0)

    out: numpy.ndarray[double]* = numpy.zeros(pool, 4)

    vipersimd.simd_min4d(a.data, b.data, out.data)
    testcheck.check(out.data[0] == double(1.0), "min[0]==1", "min[0]==1")
    testcheck.check(out.data[1] == double(2.0), "min[1]==2", "min[1]==2")
    testcheck.check(out.data[2] == double(3.0), "min[2]==3", "min[2]==3")
    testcheck.check(out.data[3] == double(4.0), "min[3]==4", "min[3]==4")

    vipersimd.simd_max4d(a.data, b.data, out.data)
    testcheck.check(out.data[0] == double(5.0), "max[0]==5", "max[0]==5")
    testcheck.check(out.data[1] == double(8.0), "max[1]==8", "max[1]==8")
    testcheck.check(out.data[2] == double(7.0), "max[2]==7", "max[2]==7")
    testcheck.check(out.data[3] == double(6.0), "max[3]==6", "max[3]==6")

    a.delete()
    b.delete()
    out.delete()


def test_avx2_scalar_ops():
    testcheck.section("AVX2 scalar broadcast ops")
    a: numpy.ndarray[double]* = numpy.zeros(pool, 4)
    a.data[0] = double(1.0)
    a.data[1] = double(2.0)
    a.data[2] = double(3.0)
    a.data[3] = double(4.0)

    s: numpy.ndarray[double]* = numpy.zeros(pool, 1)
    s.data[0] = double(10.0)

    out: numpy.ndarray[double]* = numpy.zeros(pool, 4)

    vipersimd.simd_mul_scalar4d(a.data, s.data, out.data)
    testcheck.check(out.data[0] == double(10.0), "mul_scalar[0]==10", "mul_scalar[0]==10")
    testcheck.check(out.data[1] == double(20.0), "mul_scalar[1]==20", "mul_scalar[1]==20")
    testcheck.check(out.data[3] == double(40.0), "mul_scalar[3]==40", "mul_scalar[3]==40")

    vipersimd.simd_add_scalar4d(a.data, s.data, out.data)
    testcheck.check(out.data[0] == double(11.0), "add_scalar[0]==11", "add_scalar[0]==11")
    testcheck.check(out.data[3] == double(14.0), "add_scalar[3]==14", "add_scalar[3]==14")

    a.delete()
    s.delete()
    out.delete()


def test_avx2_hsum_dot():
    testcheck.section("AVX2 hsum/dot 4d")
    a: numpy.ndarray[double]* = numpy.zeros(pool, 4)
    a.data[0] = double(1.0)
    a.data[1] = double(2.0)
    a.data[2] = double(3.0)
    a.data[3] = double(4.0)

    b: numpy.ndarray[double]* = numpy.zeros(pool, 4)
    b.data[0] = double(5.0)
    b.data[1] = double(6.0)
    b.data[2] = double(7.0)
    b.data[3] = double(8.0)

    out: numpy.ndarray[double]* = numpy.zeros(pool, 1)

    vipersimd.simd_hsum4d(a.data, out.data)
    testcheck.check(out.data[0] == double(10.0), "hsum==10", "hsum==10")

    vipersimd.simd_dot4d(a.data, b.data, out.data)
    testcheck.check(out.data[0] == double(70.0), "dot==70", "dot==70")

    a.delete()
    b.delete()
    out.delete()


def test_avx2_fma():
    testcheck.section("AVX2 FMA 4d")
    a: numpy.ndarray[double]* = numpy.zeros(pool, 4)
    a.data[0] = double(1.0)
    a.data[1] = double(2.0)
    a.data[2] = double(3.0)
    a.data[3] = double(4.0)

    b: numpy.ndarray[double]* = numpy.zeros(pool, 4)
    b.data[0] = double(5.0)
    b.data[1] = double(6.0)
    b.data[2] = double(7.0)
    b.data[3] = double(8.0)

    c_val: numpy.ndarray[double]* = numpy.ones(pool, 4)

    out: numpy.ndarray[double]* = numpy.zeros(pool, 4)

    vipersimd.simd_fma4d(a.data, b.data, c_val.data, out.data)
    testcheck.check(out.data[0] == double(6.0), "fma[0]==6", "fma[0]==6")
    testcheck.check(out.data[1] == double(13.0), "fma[1]==13", "fma[1]==13")
    testcheck.check(out.data[2] == double(22.0), "fma[2]==22", "fma[2]==22")
    testcheck.check(out.data[3] == double(33.0), "fma[3]==33", "fma[3]==33")

    a.delete()
    b.delete()
    c_val.delete()
    out.delete()


# 2. Batch array operation correctness tests

def test_batch_array_ops():
    testcheck.section("Batch array operations")
    n: sizet = 16
    a: numpy.ndarray[double]* = numpy.arange(pool, double(1.0), double(17.0), double(1.0))
    b: numpy.ndarray[double]* = numpy.full(pool, 16, double(2.0))
    out: numpy.ndarray[double]* = numpy.zeros(pool, 16)

    # add array
    vipersimd.simd_add_array(a.data, b.data, out.data, n)
    testcheck.check(out.data[0] == double(3.0), "add_arr[0]==3", "add_arr[0]==3")
    testcheck.check(out.data[15] == double(18.0), "add_arr[15]==18", "add_arr[15]==18")

    # mul array
    vipersimd.simd_mul_array(a.data, b.data, out.data, n)
    testcheck.check(out.data[0] == double(2.0), "mul_arr[0]==2", "mul_arr[0]==2")
    testcheck.check(out.data[3] == double(8.0), "mul_arr[3]==8", "mul_arr[3]==8")

    # sqrt array
    c: numpy.ndarray[double]* = numpy.zeros(pool, 4)
    c.data[0] = double(4.0)
    c.data[1] = double(9.0)
    c.data[2] = double(16.0)
    c.data[3] = double(25.0)
    out4: numpy.ndarray[double]* = numpy.zeros(pool, 4)
    vipersimd.simd_sqrt_array(c.data, out4.data, sizet(4))
    testcheck.check(out4.data[0] == double(2.0), "sqrt_arr[0]==2", "sqrt_arr[0]==2")
    testcheck.check(out4.data[3] == double(5.0), "sqrt_arr[3]==5", "sqrt_arr[3]==5")

    # abs array
    d: numpy.ndarray[double]* = numpy.zeros(pool, 4)
    d.data[0] = double(-1.0)
    d.data[1] = double(-2.0)
    d.data[2] = double(3.0)
    d.data[3] = double(-4.0)
    vipersimd.simd_abs_array(d.data, out4.data, sizet(4))
    testcheck.check(out4.data[0] == double(1.0), "abs_arr[0]==1", "abs_arr[0]==1")
    testcheck.check(out4.data[1] == double(2.0), "abs_arr[1]==2", "abs_arr[1]==2")
    testcheck.check(out4.data[3] == double(4.0), "abs_arr[3]==4", "abs_arr[3]==4")

    # dot array
    e: numpy.ndarray[double]* = numpy.zeros(pool, 4)
    e.data[0] = double(1.0)
    e.data[1] = double(2.0)
    e.data[2] = double(3.0)
    e.data[3] = double(4.0)
    f: numpy.ndarray[double]* = numpy.ones(pool, 4)
    out1: numpy.ndarray[double]* = numpy.zeros(pool, 1)
    vipersimd.simd_dot_array(e.data, f.data, sizet(4), out1.data)
    testcheck.check(out1.data[0] == double(10.0), "dot_arr==10", "dot_arr==10")

    a.delete()
    b.delete()
    out.delete()
    c.delete()
    out4.delete()
    d.delete()
    e.delete()
    f.delete()
    out1.delete()


# 3. LLVMIR precise scalar operation tests

def test_llvmir_scalar():
    testcheck.section("LLVMIR precise scalar ops")

    # sqrt
    r: double = vipersimd.simd_sqrt(double(4.0))
    testcheck.check(r == double(2.0), "sqrt(4)==2", "sqrt(4)==2")

    # fabs
    r = vipersimd.simd_fabs(double(-3.5))
    testcheck.check(r == double(3.5), "fabs(-3.5)==3.5", "fabs(-3.5)==3.5")

    # floor
    r = vipersimd.simd_floor(double(3.7))
    testcheck.check(r == double(3.0), "floor(3.7)==3", "floor(3.7)==3")

    # ceil
    r = vipersimd.simd_ceil(double(3.2))
    testcheck.check(r == double(4.0), "ceil(3.2)==4", "ceil(3.2)==4")

    # round
    r = vipersimd.simd_round(double(3.5))
    testcheck.check(r == double(4.0), "round(3.5)==4", "round(3.5)==4")

    # trunc
    r = vipersimd.simd_trunc(double(3.9))
    testcheck.check(r == double(3.0), "trunc(3.9)==3", "trunc(3.9)==3")

    # fma: 2*3+1 = 7
    r = vipersimd.simd_fma(double(2.0), double(3.0), double(1.0))
    testcheck.check(r == double(7.0), "fma(2,3,1)==7", "fma(2,3,1)==7")

    # copysign
    r = vipersimd.simd_copysign(double(3.0), double(-1.0))
    testcheck.check(r == double(-3.0), "copysign(3,-1)==-3", "copysign(3,-1)==-3")

    # neg
    r = vipersimd.simd_neg(double(1.5))
    testcheck.check(r == double(-1.5), "neg(1.5)==-1.5", "neg(1.5)==-1.5")

    # minnum
    r = vipersimd.simd_minnum(double(2.0), double(3.0))
    testcheck.check(r == double(2.0), "minnum(2,3)==2", "minnum(2,3)==2")

    # maxnum
    r = vipersimd.simd_maxnum(double(2.0), double(3.0))
    testcheck.check(r == double(3.0), "maxnum(2,3)==3", "maxnum(2,3)==3")

    # exp
    r = vipersimd.simd_exp(double(1.0))
    testcheck.check(r > double(2.71) and r < double(2.72), "exp(1)~=2.718", "exp(1)~=2.718")

    # log
    r = vipersimd.simd_log(double(2.718281828459045))
    testcheck.check(r > double(0.999) and r < double(1.001), "log(e)~=1", "log(e)~=1")

    # sin
    r = vipersimd.simd_sin(double(0.0))
    testcheck.check(r > double(-0.001) and r < double(0.001), "sin(0)~=0", "sin(0)~=0")

    # cos
    r = vipersimd.simd_cos(double(0.0))
    testcheck.check(r > double(0.999) and r < double(1.001), "cos(0)~=1", "cos(0)~=1")

    # pow
    r = vipersimd.simd_pow(double(2.0), double(10.0))
    testcheck.check(r == double(1024.0), "pow(2,10)==1024", "pow(2,10)==1024")


# 4. Benchmark: SIMD vs scalar

define N_ELEM = 40000
define N_ITER = 50000

def scalar_add_array(a: rawptr, b: rawptr, out: rawptr, n: sizet):
    da: double* = a
    db: double* = b
    dout: double* = out
    for i in range(n):
        dout[i] = da[i] + db[i]

def scalar_mul_array(a: rawptr, b: rawptr, out: rawptr, n: sizet):
    da: double* = a
    db: double* = b
    dout: double* = out
    for i in range(n):
        dout[i] = da[i] * db[i]

def scalar_sqrt_array(a: rawptr, out: rawptr, n: sizet):
    da: double* = a
    dout: double* = out
    for i in range(n):
        dout[i] = vipersimd.simd_sqrt(da[i])

def benchmark_simd_vs_scalar():
    testcheck.section("Benchmark: SIMD vs Scalar")

    a: numpy.ndarray[double]* = numpy.full(pool, N_ELEM, double(1.5))
    b: numpy.ndarray[double]* = numpy.full(pool, N_ELEM, double(2.5))
    out: numpy.ndarray[double]* = numpy.zeros(pool, N_ELEM)

    # --- SIMD add benchmark ---
    t0: t.CLong = clock()
    for iter in range(N_ITER):
        vipersimd.simd_add_array(a.data, b.data, out.data, sizet(N_ELEM))
    t1: t.CLong = clock()
    simd_add_ms: t.CLong = t1 - t0

    # --- Scalar add benchmark ---
    t0 = clock()
    for iter in range(N_ITER):
        scalar_add_array(a.data, b.data, out.data, sizet(N_ELEM))
    t1 = clock()
    scalar_add_ms: t.CLong = t1 - t0

    printf("  ADD:  SIMD=%ldms  Scalar=%ldms", simd_add_ms, scalar_add_ms)
    if scalar_add_ms > 0:
        printf("  speedup=%.1fx\n", double(scalar_add_ms) / double(simd_add_ms))
    else:
        printf("  speedup=N/A\n")

    # --- SIMD mul benchmark ---
    t0 = clock()
    for iter in range(N_ITER):
        vipersimd.simd_mul_array(a.data, b.data, out.data, sizet(N_ELEM))
    t1 = clock()
    simd_mul_ms: t.CLong = t1 - t0

    # --- Scalar mul benchmark ---
    t0 = clock()
    for iter in range(N_ITER):
        scalar_mul_array(a.data, b.data, out.data, sizet(N_ELEM))
    t1 = clock()
    scalar_mul_ms: t.CLong = t1 - t0

    printf("  MUL:  SIMD=%ldms  Scalar=%ldms", simd_mul_ms, scalar_mul_ms)
    if scalar_mul_ms > 0:
        printf("  speedup=%.1fx\n", double(scalar_mul_ms) / double(simd_mul_ms))
    else:
        printf("  speedup=N/A\n")

    # --- SIMD sqrt benchmark ---
    t0 = clock()
    for iter in range(N_ITER):
        vipersimd.simd_sqrt_array(a.data, out.data, sizet(N_ELEM))
    t1 = clock()
    simd_sqrt_ms: t.CLong = t1 - t0

    # --- Scalar sqrt benchmark ---
    t0 = clock()
    for iter in range(N_ITER):
        scalar_sqrt_array(a.data, out.data, sizet(N_ELEM))
    t1 = clock()
    scalar_sqrt_ms: t.CLong = t1 - t0

    printf("  SQRT: SIMD=%ldms  Scalar=%ldms", simd_sqrt_ms, scalar_sqrt_ms)
    if scalar_sqrt_ms > 0:
        printf("  speedup=%.1fx\n", double(scalar_sqrt_ms) / double(simd_sqrt_ms))
    else:
        printf("  speedup=N/A\n")

    # Verify result correctness
    testcheck.check(out.data[0] > double(0.0), "bench result[0] valid", "bench result[0] valid")

    a.delete()
    b.delete()
    out.delete()


# ============================================================
# Main
# ============================================================

def main() -> int:
    global arena, pool

    arena = calloc(4096 * 1024, 1)  # 4MB arena
    pool = memhub.MemPool(arena, 4096 * 1024)  # bump allocator

    testcheck.begin("ViperSIMD Test Suite")

    test_avx2_add_sub_mul_div()
    test_avx2_neg_abs_sqrt()
    test_avx2_min_max()
    test_avx2_scalar_ops()
    test_avx2_hsum_dot()
    test_avx2_fma()
    test_batch_array_ops()
    test_llvmir_scalar()
    benchmark_simd_vs_scalar()

    return testcheck.end()
