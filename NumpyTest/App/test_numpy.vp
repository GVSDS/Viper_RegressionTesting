def test_additional_creation():
    section_header("full2d / zeros_like / ones_like / arange1 / constants")

    f: numpy.ndarray[double] | t.CPtr = numpy.full2d(pool, 2, 3, double(7.0))
    check("full2d not None", f != None, "full2d returned None")
    check("full2d ndim==2", f.ndim == 2, "ndim mismatch")
    check("full2d[0,0]==7", f.at2d(0, 0) == double(7.0), "mismatch")
    check("full2d[1,2]==7", f.at2d(1, 2) == double(7.0), "mismatch")

    a: numpy.ndarray[double] | t.CPtr = vec3(pool, double(1.0), double(2.0), double(3.0))
    zl: numpy.ndarray[double] | t.CPtr = numpy.zeros_like(a)
    check("zeros_like not None", zl != None, "returned None")
    check("zeros_like size==3", zl.size == 3, "size mismatch")
    check("zeros_like[0]==0", zl.data[0] == double(0.0), "mismatch")

    ol: numpy.ndarray[double] | t.CPtr = numpy.ones_like(a)
    check("ones_like not None", ol != None, "returned None")
    check("ones_like[0]==1", ol.data[0] == double(1.0), "mismatch")

    ar: numpy.ndarray[double] | t.CPtr = numpy.arange1(pool, double(4.0))
    check("arange1 not None", ar != None, "returned None")
    check("arange1 size==4", ar.size == 4, "size mismatch")
    check("arange1[0]==0", ar.data[0] == double(0.0), "mismatch")
    check("arange1[3]==3", ar.data[3] == double(3.0), "mismatch")

    # Constants
    check("pi ~= 3.14", approx_loose(numpy.pi, double(3.14159265)), "mismatch")
    check("e ~= 2.71", approx_loose(numpy.e, double(2.71828182)), "mismatch")

    f.delete()
    a.delete()
    zl.delete()
    ol.delete()
    ar.delete()
    section_footer()


# ============================================================
# 14. Interpolation
# ============================================================
def test_interp():
    section_header("np_interp")

    xp: numpy.ndarray[double] | t.CPtr = vec3(pool, double(0.0), double(1.0), double(2.0))
    fp: numpy.ndarray[double] | t.CPtr = vec3(pool, double(0.0), double(10.0), double(20.0))

    v: double = numpy.np_interp(double(0.5), xp, fp)
    check("interp(0.5)==5", approx_eq(v, double(5.0)), "mismatch")

    v2: double = numpy.np_interp(double(1.5), xp, fp)
    check("interp(1.5)==15", approx_eq(v2, double(15.0)), "mismatch")

    v3: double = numpy.np_interp(double(-1.0), xp, fp)
    check("interp(-1)==0", approx_eq(v3, double(0.0)), "mismatch")

    v4: double = numpy.np_interp(double(3.0), xp, fp)
    check("interp(3)==20", approx_eq(v4, double(20.0)), "mismatch")

    xp.delete()
    fp.delete()
    section_footer()


# ============================================================
# 15. Edge / boundary / exception tests
# ============================================================
def test_numpy_edge():
    section_header("edge: size=0 / size=1 / non-SIMD-block / negative / div-zero")

    # size=0: pool.alloc(0) returns None, so zeros(0) returns None (expected)
    a0: numpy.ndarray[double] | t.CPtr = numpy.zeros(pool, 0)
    check("zeros(0) returns None", a0 == None, "expected None for size=0")

    # size=1
    a1: numpy.ndarray[double] | t.CPtr = numpy.zeros(pool, 1)
    check("zeros(1) not None", a1 != None, "returned None")
    check("zeros(1) size==1", a1.size == 1, "size mismatch")
    check("zeros(1) [0]==0", a1.data[0] == double(0.0), "mismatch")
    a1.delete()

    # non-SIMD-block sizes (1,2,3,5,6,7)
    a5: numpy.ndarray[double] | t.CPtr = numpy.arange(pool, double(0.0), double(5.0), double(1.0))
    check("arange(5) size==5", a5.size == 5, "size mismatch")
    check("arange(5) sum==10", approx_eq(a5.sum(), double(10.0)), "mismatch")
    a5.delete()

    a6: numpy.ndarray[double] | t.CPtr = numpy.arange(pool, double(0.0), double(6.0), double(1.0))
    check("arange(6) sum==15", approx_eq(a6.sum(), double(15.0)), "mismatch")
    a6.delete()

    a7: numpy.ndarray[double] | t.CPtr = numpy.arange(pool, double(0.0), double(7.0), double(1.0))
    check("arange(7) sum==21", approx_eq(a7.sum(), double(21.0)), "mismatch")
    a7.delete()

    # negative values in sqrt
    neg_arr: numpy.ndarray[double] | t.CPtr = vec3(pool, double(-1.0), double(0.0), double(4.0))
    r_sqrt_neg: numpy.ndarray[double] | t.CPtr = numpy.np_sqrt(neg_arr)
    check("sqrt(neg) not None", r_sqrt_neg != None, "returned None")
    # sqrt(4)=2, sqrt(0)=0; sqrt(-1) is NaN (implementation-defined)
    check("sqrt(4)==2", approx_eq(r_sqrt_neg.data[2], double(2.0)), "mismatch")
    neg_arr.delete()
    r_sqrt_neg.delete()

    # div-by-zero: b/a where a has zeros
    za: numpy.ndarray[double] | t.CPtr = vec3(pool, double(0.0), double(2.0), double(0.0))
    zb: numpy.ndarray[double] | t.CPtr = vec3(pool, double(6.0), double(4.0), double(8.0))
    r_divz: numpy.ndarray[double] | t.CPtr = za / zb
    check("0/6==0", r_divz.data[0] == double(0.0), "mismatch")
    check("2/4==0.5", r_divz.data[1] == double(0.5), "mismatch")
    za.delete()
    zb.delete()
    r_divz.delete()

    # large array (non-aligned, non-SIMD-block)
    big: numpy.ndarray[double] | t.CPtr = numpy.zeros(pool, 1000)
    check("zeros(1000) not None", big != None, "returned None")
    check("zeros(1000) size==1000", big.size == 1000, "size mismatch")
    big.delete()

    section_footer()


# ============================================================
# 16. Performance benchmark
# ============================================================
def bench_numpy_perf():
    section_header("Benchmark: numpy ops")

    N: sizet = 10000
    ITERS: int = 5

    a: numpy.ndarray[double] | t.CPtr = numpy.zeros(pool, N)
    b: numpy.ndarray[double] | t.CPtr = numpy.zeros(pool, N)
    i: sizet = 0
    while i < N:
        a.data[i] = double(1.0)
        b.data[i] = double(2.0)
        i += 1

    # add benchmark
    t0: double = timer_sec()
    j: int = 0
    while j < ITERS:
        r: numpy.ndarray[double] | t.CPtr = a + b
        r.delete()
        j += 1
    t1: double = timer_sec()
    printf("  ADD:  %.1f ms\n", (t1 - t0) * double(1000.0))

    # mul benchmark
    t0 = timer_sec()
    j = 0
    while j < ITERS:
        r2: numpy.ndarray[double] | t.CPtr = a * b
        r2.delete()
        j += 1
    t1 = timer_sec()
    printf("  MUL:  %.1f ms\n", (t1 - t0) * double(1000.0))

    # sqrt benchmark
    t0 = timer_sec()
    j = 0
    while j < ITERS:
        r3: numpy.ndarray[double] | t.CPtr = numpy.np_sqrt(a)
        r3.delete()
        j += 1
    t1 = timer_sec()
    printf("  SQRT: %.1f ms\n", (t1 - t0) * double(1000.0))

    a.delete()
    b.delete()
    section_footer()


# ============================================================
# Entry points
# ============================================================
def test_numpy_correct() -> int:
    global arena, pool, test_passed, test_failed

    arena = calloc(2 * 1024 * 1024, 1)
    pool = memhub.MemPool(arena, 2 * 1024 * 1024)

    test_passed = 0
    test_failed = 0

    printf("==============================================\n")
    printf("  numpy Correctness Tests\n")
    printf("==============================================\n")

    test_zeros_ones()
    test_arange_linspace()
    test_eye_diag()
    test_sum_mean_min_max()
    test_fill_copy()
    test_add_sub_mul_div()
    test_neg()
    test_len()
    test_scalar_ops()
    test_math_funcs()
    test_matmul()
    test_dot()
    test_transpose()
    test_var_std_norm()
    test_clip_concatenate()
    test_sort_reverse()
    test_print_arr()
    test_floordiv_mod()
    test_additional_math()
    test_trig_hyperbolic()
    test_degrees_radians()
    test_cumsum_diff()
    test_max_min_where()
    test_flatten_trace()
    test_outer()
    test_bool_comparison()
    test_linalg()
    test_additional_creation()
    test_interp()

    printf("\n==============================================\n")
    printf("  Correctness: %d passed, %d failed\n", test_passed, test_failed)
    printf("==============================================\n")

    return test_failed


def test_numpy_edge_main() -> int:
    global arena, pool, test_passed, test_failed

    arena = calloc(2 * 1024 * 1024, 1)
    pool = memhub.MemPool(arena, 2 * 1024 * 1024)

    test_passed = 0
    test_failed = 0

    printf("==============================================\n")
    printf("  numpy Edge / Boundary Tests\n")
    printf("==============================================\n")

    test_numpy_edge()

    printf("\n==============================================\n")
    printf("  Edge: %d passed, %d failed\n", test_passed, test_failed)
    printf("==============================================\n")

    return test_failed


def bench_numpy_main() -> int:
    global arena, pool

    arena = calloc(8 * 1024 * 1024, 1)
    pool = memhub.MemPool(arena, 8 * 1024 * 1024)

    printf("==============================================\n")
    printf("  numpy Performance Benchmark\n")
    printf("==============================================\n")

    bench_numpy_perf()

    printf("==============================================\n")
    return 0


# Backward-compatible entry
def test_numpy_main() -> int:
    global arena, pool

    arena = calloc(2 * 1024 * 1024, 1)
    pool = memhub.MemPool(arena, 2 * 1024 * 1024)

    failed: int = test_numpy_correct()
    if failed == 0:
        failed = test_numpy_edge_main()
    if failed == 0:
        bench_numpy_main()
    return failed
