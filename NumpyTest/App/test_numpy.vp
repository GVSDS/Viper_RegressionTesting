from stdint import *
import numpy
from stdio import printf
from stdlib import calloc, free
import string
import math
import memhub
import w32.win32base
import t, c

# ============================================================
# Constants
# ============================================================
EPS: double = double(1e-9)
EPS_LOOSE: double = double(1e-5)
SIMD_BLOCK: sizet = 4

# ============================================================
# Global state
# ============================================================
arena: uint8 | t.CPtr = None
pool: memhub.MemPool | t.CPtr = None

test_passed: int = 0
test_failed: int = 0

# ============================================================
# Global check function
# ============================================================
def check(name: str, condition: int, detail: str):
    global test_passed, test_failed
    if condition:
        test_passed += 1
        printf("  [PASS] %s\n", name)
    else:
        test_failed += 1
        printf("  [FAIL] %s  -- %s\n", name, detail if detail else "")


# ============================================================
# Approximate comparison (top-level, uses vipermath.fabs)
# ============================================================
def approx_eq(a: double, b: double) -> int:
    d: double = a - b
    if d < double(0.0):
        d = double(0.0) - d
    if d < EPS:
        return 1
    return 0

def approx_loose(a: double, b: double) -> int:
    d: double = a - b
    if d < double(0.0):
        d = double(0.0) - d
    if d < EPS_LOOSE:
        return 1
    return 0


# ============================================================
# Section headers
# ============================================================
def section_header(title: str):
    printf("\n+-- %s --+\n", title)

def section_footer():
    printf("+--------------------------------------------+\n")


# ============================================================
# Timer: 单调时钟（GetTickCount64 毫秒 → 秒）
# 原 c.Timer() 无编译器支持（TPC/TPV 均无），改用 Win32 API
# ============================================================
def timer_sec() -> double:
    return double(w32.win32base.GetTickCount64()) / double(1000.0)


# ============================================================
# Utility: quick array creation
# ============================================================
def vec4(p: memhub.MemPool | t.CPtr, v0: double, v1: double, v2: double, v3: double) -> numpy.ndarray[double] | t.CPtr:
    a: numpy.ndarray[double] | t.CPtr = numpy.zeros(p, 4)
    a.data[0] = v0; a.data[1] = v1; a.data[2] = v2; a.data[3] = v3
    return a

def vec3(p: memhub.MemPool | t.CPtr, v0: double, v1: double, v2: double) -> numpy.ndarray[double] | t.CPtr:
    a: numpy.ndarray[double] | t.CPtr = numpy.zeros(p, 3)
    a.data[0] = v0; a.data[1] = v1; a.data[2] = v2
    return a

def vec2(p: memhub.MemPool | t.CPtr, v0: double, v1: double) -> numpy.ndarray[double] | t.CPtr:
    a: numpy.ndarray[double] | t.CPtr = numpy.zeros(p, 2)
    a.data[0] = v0; a.data[1] = v1
    return a


# ============================================================
# 1. Array creation
# ============================================================
def test_zeros_ones():
    section_header("zeros / ones / full")

    a: numpy.ndarray[double] | t.CPtr = numpy.zeros(pool, 5)
    check("zeros not None", a != None, "zeros returned None")
    check("zeros size == 5", a.size == 5, "size mismatch")
    check("zeros [0]==0", a.data[0] == double(0.0), "not zero")
    check("zeros [4]==0", a.data[4] == double(0.0), "not zero")

    b: numpy.ndarray[double] | t.CPtr = numpy.ones(pool, 4)
    check("ones not None", b != None, "ones returned None")
    check("ones [0]==1", b.data[0] == double(1.0), "not one")
    check("ones [3]==1", b.data[3] == double(1.0), "not one")

    c: numpy.ndarray[double] | t.CPtr = numpy.full(pool, 3, double(7.5))
    check("full not None", c != None, "full returned None")
    check("full value", c.data[0] == double(7.5), "value mismatch")

    a.delete()
    b.delete()
    c.delete()
    section_footer()


def test_arange_linspace():
    section_header("arange / linspace")

    a: numpy.ndarray[double] | t.CPtr = numpy.arange(pool, double(0.0), double(5.0), double(1.0))
    check("arange not None", a != None, "arange returned None")
    check("arange size == 5", a.size == 5, "size mismatch")
    check("arange [0]==0", approx_eq(a.data[0], double(0.0)), "mismatch")
    check("arange [4]==4", approx_eq(a.data[4], double(4.0)), "mismatch")

    b: numpy.ndarray[double] | t.CPtr = numpy.linspace(pool, double(0.0), double(1.0), 5)
    check("linspace not None", b != None, "linspace returned None")
    check("linspace size == 5", b.size == 5, "size mismatch")
    check("linspace [0]==0", approx_eq(b.data[0], double(0.0)), "mismatch")
    check("linspace [4]==1", approx_eq(b.data[4], double(1.0)), "mismatch")

    a.delete()
    b.delete()
    section_footer()


def test_eye_diag():
    section_header("eye / diag")

    e: numpy.ndarray[double] | t.CPtr = numpy.eye(pool, 3)
    check("eye not None", e != None, "eye returned None")
    check("eye ndim == 2", e.ndim == 2, "ndim mismatch")
    check("eye [0,0]==1", e.at2d(0, 0) == double(1.0), "mismatch")
    check("eye [0,1]==0", e.at2d(0, 1) == double(0.0), "mismatch")
    check("eye [1,1]==1", e.at2d(1, 1) == double(1.0), "mismatch")

    vals: numpy.ndarray[double] | t.CPtr = vec3(pool, double(1.0), double(2.0), double(3.0))
    d: numpy.ndarray[double] | t.CPtr = numpy.diag(pool, vals)
    check("diag not None", d != None, "diag returned None")
    check("diag [0,0]==1", d.at2d(0, 0) == double(1.0), "mismatch")
    check("diag [1,1]==2", d.at2d(1, 1) == double(2.0), "mismatch")
    check("diag [2,2]==3", d.at2d(2, 2) == double(3.0), "mismatch")

    e.delete()
    vals.delete()
    d.delete()
    section_footer()


# ============================================================
# 2. Methods
# ============================================================
def test_sum_mean_min_max():
    section_header("sum / mean / min / max / argmax / argmin")

    a: numpy.ndarray[double] | t.CPtr = numpy.arange(pool, double(1.0), double(6.0), double(1.0))
    check("sum == 15", approx_eq(a.sum(), double(15.0)), "mismatch")
    check("mean == 3", approx_eq(a.mean(), double(3.0)), "mismatch")
    check("min == 1", approx_eq(a.min(), double(1.0)), "mismatch")
    check("max == 5", approx_eq(a.max(), double(5.0)), "mismatch")
    check("argmax == 4", a.argmax() == 4, "mismatch")
    check("argmin == 0", a.argmin() == 0, "mismatch")

    a.delete()
    section_footer()


def test_fill_copy():
    section_header("fill / copy")

    a: numpy.ndarray[double] | t.CPtr = numpy.zeros(pool, 3)
    a.fill(double(9.0))
    check("fill [0]==9", a.data[0] == double(9.0), "mismatch")
    check("fill [2]==9", a.data[2] == double(9.0), "mismatch")

    b: numpy.ndarray[double] | t.CPtr = a.copy()
    check("copy not None", b != None, "copy returned None")
    check("copy [0]==9", b.data[0] == double(9.0), "mismatch")

    b.data[0] = double(0.0)
    check("copy is independent", a.data[0] == double(9.0), "copy not independent")

    a.delete()
    b.delete()
    section_footer()


# ============================================================
# 3. Operator overloading
# ============================================================
def test_add_sub_mul_div():
    section_header("__add__ / __sub__ / __mul__ / __truediv__")

    a: numpy.ndarray[double] | t.CPtr = vec3(pool, double(1.0), double(2.0), double(3.0))
    b: numpy.ndarray[double] | t.CPtr = vec3(pool, double(4.0), double(5.0), double(6.0))

    c_add: numpy.ndarray[double] | t.CPtr = a + b
    check("a+b not None", c_add != None, "add returned None")
    check("a+b [0]==5", c_add.data[0] == double(5.0), "mismatch")
    check("a+b [2]==9", c_add.data[2] == double(9.0), "mismatch")

    c_sub: numpy.ndarray[double] | t.CPtr = a - b
    check("a-b [0]==-3", c_sub.data[0] == double(-3.0), "mismatch")

    c_mul: numpy.ndarray[double] | t.CPtr = a * b
    check("a*b [1]==10", c_mul.data[1] == double(10.0), "mismatch")

    c_div: numpy.ndarray[double] | t.CPtr = b / a
    check("b/a [0]==4", c_div.data[0] == double(4.0), "mismatch")
    check("b/a [2]==2", c_div.data[2] == double(2.0), "mismatch")

    a.delete()
    b.delete()
    c_add.delete()
    c_sub.delete()
    c_mul.delete()
    c_div.delete()
    section_footer()


def test_neg():
    section_header("__neg__")

    a: numpy.ndarray[double] | t.CPtr = vec3(pool, double(1.0), double(-2.0), double(3.0))
    neg_a: numpy.ndarray[double] | t.CPtr = -a
    check("neg not None", neg_a != None, "neg returned None")
    check("neg [0]==-1", neg_a.data[0] == double(-1.0), "mismatch")
    check("neg [1]==2", neg_a.data[1] == double(2.0), "mismatch")

    a.delete()
    neg_a.delete()
    section_footer()


def test_len():
    section_header("__len__")

    a: numpy.ndarray[double] | t.CPtr = numpy.zeros(pool, 10)
    check("len == 10", len(a) == 10, "mismatch")

    a.delete()
    section_footer()


# ============================================================
# 4. Scalar operations
# ============================================================
def test_scalar_ops():
    section_header("add_scalar / mul_scalar / sub_scalar / div_scalar")

    a: numpy.ndarray[double] | t.CPtr = numpy.ones(pool, 3)

    r1: numpy.ndarray[double] | t.CPtr = numpy.add_scalar(a, double(2.0))
    check("add_scalar [0]==3", r1.data[0] == double(3.0), "mismatch")

    r2: numpy.ndarray[double] | t.CPtr = numpy.mul_scalar(a, double(5.0))
    check("mul_scalar [0]==5", r2.data[0] == double(5.0), "mismatch")

    r3: numpy.ndarray[double] | t.CPtr = numpy.sub_scalar(a, double(0.5))
    check("sub_scalar [0]==0.5", r3.data[0] == double(0.5), "mismatch")

    r4: numpy.ndarray[double] | t.CPtr = numpy.div_scalar(a, double(2.0))
    check("div_scalar [0]==0.5", r4.data[0] == double(0.5), "mismatch")

    a.delete()
    r1.delete()
    r2.delete()
    r3.delete()
    r4.delete()
    section_footer()


# ============================================================
# 5. Math functions
# ============================================================
def test_math_funcs():
    section_header("np_abs / np_sqrt / np_pow")

    a: numpy.ndarray[double] | t.CPtr = vec3(pool, double(1.0), double(4.0), double(9.0))

    r_sqrt: numpy.ndarray[double] | t.CPtr = numpy.np_sqrt(a)
    check("sqrt [0]==1", approx_eq(r_sqrt.data[0], double(1.0)), "mismatch")
    check("sqrt [1]==2", approx_eq(r_sqrt.data[1], double(2.0)), "mismatch")
    check("sqrt [2]==3", approx_eq(r_sqrt.data[2], double(3.0)), "mismatch")

    b: numpy.ndarray[double] | t.CPtr = vec3(pool, double(-1.0), double(-4.0), double(9.0))
    r_abs: numpy.ndarray[double] | t.CPtr = numpy.np_abs(b)
    check("abs [0]==1", approx_eq(r_abs.data[0], double(1.0)), "mismatch")
    check("abs [1]==4", approx_eq(r_abs.data[1], double(4.0)), "mismatch")

    c: numpy.ndarray[double] | t.CPtr = vec3(pool, double(1.0), double(2.0), double(3.0))
    r_pow: numpy.ndarray[double] | t.CPtr = numpy.np_pow(c, double(2.0))
    check("pow [0]==1", approx_eq(r_pow.data[0], double(1.0)), "mismatch")
    check("pow [1]==4", approx_eq(r_pow.data[1], double(4.0)), "mismatch")
    check("pow [2]==9", approx_eq(r_pow.data[2], double(9.0)), "mismatch")

    a.delete()
    b.delete()
    c.delete()
    r_sqrt.delete()
    r_abs.delete()
    r_pow.delete()
    section_footer()


# ============================================================
# 6. Matrix operations
# ============================================================
def test_matmul():
    section_header("matmul")

    # [1,2;3,4] x [5,6;7,8] = [19,22;43,50]
    a: numpy.ndarray[double] | t.CPtr = numpy.empty2d(pool, 2, 2)
    a.set2d(0, 0, double(1.0)); a.set2d(0, 1, double(2.0))
    a.set2d(1, 0, double(3.0)); a.set2d(1, 1, double(4.0))

    b: numpy.ndarray[double] | t.CPtr = numpy.empty2d(pool, 2, 2)
    b.set2d(0, 0, double(5.0)); b.set2d(0, 1, double(6.0))
    b.set2d(1, 0, double(7.0)); b.set2d(1, 1, double(8.0))

    c: numpy.ndarray[double] | t.CPtr = numpy.matmul(a, b)
    check("matmul not None", c != None, "matmul returned None")
    check("matmul [0,0]==19", c.at2d(0, 0) == double(19.0), "mismatch")
    check("matmul [0,1]==22", c.at2d(0, 1) == double(22.0), "mismatch")
    check("matmul [1,0]==43", c.at2d(1, 0) == double(43.0), "mismatch")
    check("matmul [1,1]==50", c.at2d(1, 1) == double(50.0), "mismatch")

    a.delete()
    b.delete()
    c.delete()
    section_footer()


def test_dot():
    section_header("dot / dot_product")

    a: numpy.ndarray[double] | t.CPtr = vec3(pool, double(1.0), double(2.0), double(3.0))
    b: numpy.ndarray[double] | t.CPtr = vec3(pool, double(4.0), double(5.0), double(6.0))

    d: double = a.dot(b)
    check("dot == 32", approx_eq(d, double(32.0)), "mismatch")

    d2: double = numpy.dot_product(a, b)
    check("dot_product == 32", approx_eq(d2, double(32.0)), "mismatch")

    a.delete()
    b.delete()
    section_footer()


def test_transpose():
    section_header("T (transpose)")

    a: numpy.ndarray[double] | t.CPtr = numpy.empty2d(pool, 2, 3)
    a.set2d(0, 0, double(1.0)); a.set2d(0, 1, double(2.0)); a.set2d(0, 2, double(3.0))
    a.set2d(1, 0, double(4.0)); a.set2d(1, 1, double(5.0)); a.set2d(1, 2, double(6.0))

    at: numpy.ndarray[double] | t.CPtr = a.T()
    check("T not None", at != None, "T returned None")
    check("T shape[0]==3", at.shape[0] == 3, "shape mismatch")
    check("T shape[1]==2", at.shape[1] == 2, "shape mismatch")
    check("T [0,0]==1", at.at2d(0, 0) == double(1.0), "mismatch")
    check("T [0,1]==4", at.at2d(0, 1) == double(4.0), "mismatch")
    check("T [1,0]==2", at.at2d(1, 0) == double(2.0), "mismatch")

    a.delete()
    at.delete()
    section_footer()


# ============================================================
# 7. Utility
# ============================================================
def test_var_std_norm():
    section_header("var / std / norm")

    # [2,4,4,4,5,5,7,9] mean=5, var=4, std=2
    a: numpy.ndarray[double] | t.CPtr = numpy.zeros(pool, 8)
    a.data[0] = double(2.0); a.data[1] = double(4.0)
    a.data[2] = double(4.0); a.data[3] = double(4.0)
    a.data[4] = double(5.0); a.data[5] = double(5.0)
    a.data[6] = double(7.0); a.data[7] = double(9.0)

    v: double = numpy.var(a)
    printf("  var = %.6f (expect 4.0)\n", v)
    check("var ~= 4", approx_eq(v, double(4.0)), "mismatch")

    s: double = numpy.std(a)
    printf("  std = %.6f (expect 2.0)\n", s)
    check("std ~= 2", approx_eq(s, double(2.0)), "mismatch")

    b: numpy.ndarray[double] | t.CPtr = vec2(pool, double(3.0), double(4.0))
    n: double = numpy.norm(b)
    printf("  norm = %.6f (expect 5.0)\n", n)
    check("norm ~= 5", approx_eq(n, double(5.0)), "mismatch")

    a.delete()
    b.delete()
    section_footer()


def test_clip_concatenate():
    section_header("clip / concatenate")

    a: numpy.ndarray[double] | t.CPtr = vec3(pool, double(1.0), double(5.0), double(10.0))
    r: numpy.ndarray[double] | t.CPtr = numpy.clip(a, double(2.0), double(8.0))
    check("clip [0]==2", r.data[0] == double(2.0), "mismatch")
    check("clip [1]==5", r.data[1] == double(5.0), "mismatch")
    check("clip [2]==8", r.data[2] == double(8.0), "mismatch")

    b: numpy.ndarray[double] | t.CPtr = vec2(pool, double(1.0), double(2.0))
    c: numpy.ndarray[double] | t.CPtr = vec2(pool, double(3.0), double(4.0))
    cat: numpy.ndarray[double] | t.CPtr = numpy.concatenate(b, c)
    check("concatenate not None", cat != None, "concatenate returned None")
    check("concatenate size == 4", cat.size == 4, "size mismatch")
    check("concatenate [0]==1", cat.data[0] == double(1.0), "mismatch")
    check("concatenate [3]==4", cat.data[3] == double(4.0), "mismatch")

    a.delete()
    r.delete()
    b.delete()
    c.delete()
    cat.delete()
    section_footer()


def test_sort_reverse():
    section_header("sort_arr / reverse")

    a: numpy.ndarray[double] | t.CPtr = vec3(pool, double(3.0), double(1.0), double(2.0))
    s: numpy.ndarray[double] | t.CPtr = numpy.sort_arr(a)
    check("sort not None", s != None, "sort returned None")
    check("sort [0]==1", s.data[0] == double(1.0), "mismatch")
    check("sort [1]==2", s.data[1] == double(2.0), "mismatch")
    check("sort [2]==3", s.data[2] == double(3.0), "mismatch")

    r: numpy.ndarray[double] | t.CPtr = numpy.reverse(a)
    check("reverse not None", r != None, "reverse returned None")
    check("reverse [0]==2", r.data[0] == double(2.0), "mismatch")
    check("reverse [1]==1", r.data[1] == double(1.0), "mismatch")
    check("reverse [2]==3", r.data[2] == double(3.0), "mismatch")

    a.delete()
    s.delete()
    r.delete()
    section_footer()


def test_print_arr():
    section_header("print_arr")

    a: numpy.ndarray[double] | t.CPtr = vec3(pool, double(1.0), double(2.0), double(3.0))
    printf("  1D array: ")
    a.print_arr()

    b: numpy.ndarray[double] | t.CPtr = numpy.eye(pool, 3)
    printf("  2D eye(3):\n")
    b.print_arr()

    a.delete()
    b.delete()
    section_footer()


# ============================================================
# 8. Additional operator overloading
# ============================================================
def test_floordiv_mod():
    section_header("__floordiv__ / __mod__")

    a: numpy.ndarray[double] | t.CPtr = vec3(pool, double(7.0), double(10.0), double(15.0))
    b: numpy.ndarray[double] | t.CPtr = vec3(pool, double(2.0), double(3.0), double(4.0))

    c_fd: numpy.ndarray[double] | t.CPtr = a // b
    check("7//2==3", c_fd.data[0] == double(3.0), "mismatch")
    check("10//3==3", c_fd.data[1] == double(3.0), "mismatch")
    check("15//4==3", c_fd.data[2] == double(3.0), "mismatch")

    c_mod: numpy.ndarray[double] | t.CPtr = a % b
    check("7%%2==1", c_mod.data[0] == double(1.0), "mismatch")
    check("10%%3==1", c_mod.data[1] == double(1.0), "mismatch")
    check("15%%4==3", c_mod.data[2] == double(3.0), "mismatch")

    a.delete()
    b.delete()
    c_fd.delete()
    c_mod.delete()
    section_footer()


# ============================================================
# 9. Additional math functions
# ============================================================
def test_additional_math():
    section_header("np_log10 / np_log2 / np_floor / np_ceil / np_round / np_sign")

    a: numpy.ndarray[double] | t.CPtr = vec3(pool, double(10.0), double(100.0), double(1000.0))
    r_log10: numpy.ndarray[double] | t.CPtr = numpy.np_log10(a)
    check("log10(10)~=1", approx_loose(r_log10.data[0], double(1.0)), "mismatch")
    check("log10(100)~=2", approx_loose(r_log10.data[1], double(2.0)), "mismatch")

    b: numpy.ndarray[double] | t.CPtr = vec3(pool, double(2.0), double(4.0), double(8.0))
    r_log2: numpy.ndarray[double] | t.CPtr = numpy.np_log2(b)
    check("log2(2)~=1", approx_loose(r_log2.data[0], double(1.0)), "mismatch")
    check("log2(4)~=2", approx_loose(r_log2.data[1], double(2.0)), "mismatch")

    c: numpy.ndarray[double] | t.CPtr = vec3(pool, double(1.5), double(2.7), double(-1.3))
    r_floor: numpy.ndarray[double] | t.CPtr = numpy.np_floor(c)
    check("floor(1.5)==1", r_floor.data[0] == double(1.0), "mismatch")
    check("floor(2.7)==2", r_floor.data[1] == double(2.0), "mismatch")
    check("floor(-1.3)==-2", r_floor.data[2] == double(-2.0), "mismatch")

    r_ceil: numpy.ndarray[double] | t.CPtr = numpy.np_ceil(c)
    check("ceil(1.5)==2", r_ceil.data[0] == double(2.0), "mismatch")
    check("ceil(2.7)==3", r_ceil.data[1] == double(3.0), "mismatch")
    check("ceil(-1.3)==-1", r_ceil.data[2] == double(-1.0), "mismatch")

    d: numpy.ndarray[double] | t.CPtr = vec3(pool, double(1.4), double(2.5), double(3.6))
    r_round: numpy.ndarray[double] | t.CPtr = numpy.np_round(d)
    check("round(1.4)==1", r_round.data[0] == double(1.0), "mismatch")
    check("round(3.6)==4", r_round.data[2] == double(4.0), "mismatch")

    e: numpy.ndarray[double] | t.CPtr = numpy.zeros(pool, 4)
    e.data[0] = double(-3.0); e.data[1] = double(0.0); e.data[2] = double(5.0); e.data[3] = double(-0.1)
    r_sign: numpy.ndarray[double] | t.CPtr = numpy.np_sign(e)
    check("sign(-3)==-1", r_sign.data[0] == double(-1.0), "mismatch")
    check("sign(0)==0", r_sign.data[1] == double(0.0), "mismatch")
    check("sign(5)==1", r_sign.data[2] == double(1.0), "mismatch")

    a.delete()
    b.delete()
    c.delete()
    d.delete()
    e.delete()
    r_log10.delete()
    r_log2.delete()
    r_floor.delete()
    r_ceil.delete()
    r_round.delete()
    r_sign.delete()
    section_footer()


def test_trig_hyperbolic():
    section_header("np_tanh / np_sinh / np_cosh / np_arcsin / np_arccos / np_arctan")

    a: numpy.ndarray[double] | t.CPtr = vec3(pool, double(0.0), double(1.0), double(-1.0))

    r_tanh: numpy.ndarray[double] | t.CPtr = numpy.np_tanh(a)
    check("tanh(0)~=0", approx_loose(r_tanh.data[0], double(0.0)), "mismatch")

    r_sinh: numpy.ndarray[double] | t.CPtr = numpy.np_sinh(a)
    check("sinh(0)~=0", approx_loose(r_sinh.data[0], double(0.0)), "mismatch")

    r_cosh: numpy.ndarray[double] | t.CPtr = numpy.np_cosh(a)
    check("cosh(0)~=1", approx_loose(r_cosh.data[0], double(1.0)), "mismatch")

    b: numpy.ndarray[double] | t.CPtr = vec2(pool, double(0.0), double(0.5))
    r_asin: numpy.ndarray[double] | t.CPtr = numpy.np_arcsin(b)
    check("arcsin(0)~=0", approx_loose(r_asin.data[0], double(0.0)), "mismatch")

    r_acos: numpy.ndarray[double] | t.CPtr = numpy.np_arccos(b)
    check("arccos(0)~=pi/2", approx_loose(r_acos.data[0], double(1.5707963)), "mismatch")

    r_atan: numpy.ndarray[double] | t.CPtr = numpy.np_arctan(b)
    check("arctan(0)~=0", approx_loose(r_atan.data[0], double(0.0)), "mismatch")

    a.delete()
    b.delete()
    r_tanh.delete()
    r_sinh.delete()
    r_cosh.delete()
    r_asin.delete()
    r_acos.delete()
    r_atan.delete()
    section_footer()


def test_degrees_radians():
    section_header("np_degrees / np_radians")

    a: numpy.ndarray[double] | t.CPtr = vec2(pool, double(0.0), double(1.5707963267948966))

    r_deg: numpy.ndarray[double] | t.CPtr = numpy.np_degrees(a)
    check("deg(0)~=0", approx_loose(r_deg.data[0], double(0.0)), "mismatch")
    check("deg(pi/2)~=90", approx_loose(r_deg.data[1], double(90.0)), "mismatch")

    b: numpy.ndarray[double] | t.CPtr = vec2(pool, double(0.0), double(90.0))
    r_rad: numpy.ndarray[double] | t.CPtr = numpy.np_radians(b)
    check("rad(0)~=0", approx_loose(r_rad.data[0], double(0.0)), "mismatch")
    check("rad(90)~=pi/2", approx_loose(r_rad.data[1], double(1.5707963)), "mismatch")

    a.delete()
    b.delete()
    r_deg.delete()
    r_rad.delete()
    section_footer()


