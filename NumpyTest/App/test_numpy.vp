def test_cumsum_diff():
    section_header("cumsum / diff")

    a: numpy.ndarray[double] | t.CPtr = numpy.zeros(pool, 4)
    a.data[0] = double(1.0); a.data[1] = double(2.0); a.data[2] = double(3.0); a.data[3] = double(4.0)

    r_cs: numpy.ndarray[double] | t.CPtr = numpy.cumsum(a)
    check("cumsum not None", r_cs != None, "cumsum returned None")
    check("cumsum[0]==1", r_cs.data[0] == double(1.0), "mismatch")
    check("cumsum[1]==3", r_cs.data[1] == double(3.0), "mismatch")
    check("cumsum[2]==6", r_cs.data[2] == double(6.0), "mismatch")
    check("cumsum[3]==10", r_cs.data[3] == double(10.0), "mismatch")

    r_diff: numpy.ndarray[double] | t.CPtr = numpy.diff(a)
    check("diff not None", r_diff != None, "diff returned None")
    check("diff size==3", r_diff.size == 3, "size mismatch")
    check("diff[0]==1", r_diff.data[0] == double(1.0), "mismatch")
    check("diff[2]==1", r_diff.data[2] == double(1.0), "mismatch")

    a.delete()
    r_cs.delete()
    r_diff.delete()
    section_footer()


def test_max_min_where():
    section_header("np_maximum / np_minimum / np_where")

    a: numpy.ndarray[double] | t.CPtr = vec3(pool, double(1.0), double(5.0), double(3.0))
    b: numpy.ndarray[double] | t.CPtr = vec3(pool, double(4.0), double(2.0), double(6.0))

    r_max: numpy.ndarray[double] | t.CPtr = numpy.np_maximum(a, b)
    check("maximum[0]==4", r_max.data[0] == double(4.0), "mismatch")
    check("maximum[1]==5", r_max.data[1] == double(5.0), "mismatch")
    check("maximum[2]==6", r_max.data[2] == double(6.0), "mismatch")

    r_min: numpy.ndarray[double] | t.CPtr = numpy.np_minimum(a, b)
    check("minimum[0]==1", r_min.data[0] == double(1.0), "mismatch")
    check("minimum[1]==2", r_min.data[1] == double(2.0), "mismatch")
    check("minimum[2]==3", r_min.data[2] == double(3.0), "mismatch")

    # where: cond > 0 ? a : b
    cond: numpy.ndarray[double] | t.CPtr = vec3(pool, double(0.0), double(1.0), double(0.0))
    r_where: numpy.ndarray[double] | t.CPtr = numpy.np_where(cond, a, b)
    check("where[0]==4", r_where.data[0] == double(4.0), "mismatch")
    check("where[1]==5", r_where.data[1] == double(5.0), "mismatch")
    check("where[2]==6", r_where.data[2] == double(6.0), "mismatch")

    a.delete()
    b.delete()
    cond.delete()
    r_max.delete()
    r_min.delete()
    r_where.delete()
    section_footer()


def test_flatten_trace():
    section_header("flatten / trace")

    a: numpy.ndarray[double] | t.CPtr = numpy.empty2d(pool, 2, 3)
    a.set2d(0, 0, double(1.0)); a.set2d(0, 1, double(2.0)); a.set2d(0, 2, double(3.0))
    a.set2d(1, 0, double(4.0)); a.set2d(1, 1, double(5.0)); a.set2d(1, 2, double(6.0))

    r_flat: numpy.ndarray[double] | t.CPtr = numpy.flatten(a)
    check("flatten not None", r_flat != None, "flatten returned None")
    check("flatten ndim==1", r_flat.ndim == 1, "ndim mismatch")
    check("flatten size==6", r_flat.size == 6, "size mismatch")
    check("flatten[0]==1", r_flat.data[0] == double(1.0), "mismatch")

    # trace of [[1,2],[3,4]] = 1+4 = 5
    b: numpy.ndarray[double] | t.CPtr = numpy.empty2d(pool, 2, 2)
    b.set2d(0, 0, double(1.0)); b.set2d(0, 1, double(2.0))
    b.set2d(1, 0, double(3.0)); b.set2d(1, 1, double(4.0))
    tr: double = numpy.trace(b)
    check("trace == 5", tr == double(5.0), "mismatch")

    a.delete()
    r_flat.delete()
    b.delete()
    section_footer()


def test_outer():
    section_header("outer")

    a: numpy.ndarray[double] | t.CPtr = vec2(pool, double(1.0), double(2.0))
    b: numpy.ndarray[double] | t.CPtr = vec3(pool, double(3.0), double(4.0), double(5.0))

    r: numpy.ndarray[double] | t.CPtr = numpy.outer(a, b)
    check("outer not None", r != None, "outer returned None")
    check("outer ndim==2", r.ndim == 2, "ndim mismatch")
    check("outer[0,0]==3", r.at2d(0, 0) == double(3.0), "mismatch")
    check("outer[0,1]==4", r.at2d(0, 1) == double(4.0), "mismatch")
    check("outer[1,0]==6", r.at2d(1, 0) == double(6.0), "mismatch")
    check("outer[1,2]==10", r.at2d(1, 2) == double(10.0), "mismatch")

    a.delete()
    b.delete()
    r.delete()
    section_footer()


# ============================================================
# 11. Boolean / comparison
# ============================================================
def test_bool_comparison():
    section_header("np_all / np_any / np_count_nonzero / np_equal / np_less / np_greater")

    a: numpy.ndarray[double] | t.CPtr = numpy.zeros(pool, 4)
    a.data[0] = double(1.0); a.data[1] = double(0.0); a.data[2] = double(3.0); a.data[3] = double(0.0)
    check("count_nonzero==2", numpy.np_count_nonzero(a) == 2, "mismatch")
    check("any==1", numpy.np_any(a) == 1, "mismatch")

    b: numpy.ndarray[double] | t.CPtr = vec3(pool, double(1.0), double(2.0), double(3.0))
    check("all(1,2,3)==1", numpy.np_all(b) == 1, "mismatch")

    c: numpy.ndarray[double] | t.CPtr = numpy.zeros(pool, 3)
    check("all(0,0,0)==0", numpy.np_all(c) == 0, "mismatch")
    check("any(0,0,0)==0", numpy.np_any(c) == 0, "mismatch")

    d: numpy.ndarray[double] | t.CPtr = vec3(pool, double(1.0), double(2.0), double(3.0))
    e: numpy.ndarray[double] | t.CPtr = vec3(pool, double(1.0), double(0.0), double(4.0))

    r_eq: numpy.ndarray[double] | t.CPtr = numpy.np_equal(d, e)
    check("equal[0]==1", r_eq.data[0] == double(1.0), "mismatch")
    check("equal[1]==0", r_eq.data[1] == double(0.0), "mismatch")

    r_lt: numpy.ndarray[double] | t.CPtr = numpy.np_less(d, e)
    check("less[2]==1", r_lt.data[2] == double(1.0), "mismatch")
    check("less[0]==0", r_lt.data[0] == double(0.0), "mismatch")

    r_gt: numpy.ndarray[double] | t.CPtr = numpy.np_greater(d, e)
    check("greater[1]==1", r_gt.data[1] == double(1.0), "mismatch")

    a.delete()
    b.delete()
    c.delete()
    d.delete()
    e.delete()
    r_eq.delete()
    r_lt.delete()
    r_gt.delete()
    section_footer()


# ============================================================
# 12. Linear algebra
# ============================================================
def test_linalg():
    section_header("det2x2 / inv2x2 / cross3 / prod / median / percentile")

    # det2x2: [[1,2],[3,4]] -> 1*4-2*3 = -2
    a: numpy.ndarray[double] | t.CPtr = numpy.empty2d(pool, 2, 2)
    a.set2d(0, 0, double(1.0)); a.set2d(0, 1, double(2.0))
    a.set2d(1, 0, double(3.0)); a.set2d(1, 1, double(4.0))
    d: double = numpy.det2x2(a)
    check("det2x2==-2", d == double(-2.0), "mismatch")

    # inv2x2 of [[1,2],[3,4]]
    inv: numpy.ndarray[double] | t.CPtr = numpy.inv2x2(a)
    check("inv2x2 not None", inv != None, "inv2x2 returned None")
    check("inv[0,0]==-2", approx_eq(inv.at2d(0, 0), double(-2.0)), "mismatch")
    check("inv[0,1]==1", approx_eq(inv.at2d(0, 1), double(1.0)), "mismatch")

    # cross3: [1,0,0] x [0,1,0] = [0,0,1]
    x: numpy.ndarray[double] | t.CPtr = vec3(pool, double(1.0), double(0.0), double(0.0))
    y: numpy.ndarray[double] | t.CPtr = vec3(pool, double(0.0), double(1.0), double(0.0))
    cr: numpy.ndarray[double] | t.CPtr = numpy.cross3(x, y)
    check("cross not None", cr != None, "cross returned None")
    check("cross[2]==1", cr.data[2] == double(1.0), "mismatch")

    # prod
    p: numpy.ndarray[double] | t.CPtr = numpy.zeros(pool, 4)
    p.data[0] = double(1.0); p.data[1] = double(2.0); p.data[2] = double(3.0); p.data[3] = double(4.0)
    check("prod==24", numpy.prod(p) == double(24.0), "mismatch")

    # median
    m: numpy.ndarray[double] | t.CPtr = numpy.zeros(pool, 5)
    m.data[0] = double(3.0); m.data[1] = double(1.0); m.data[2] = double(2.0)
    m.data[3] = double(5.0); m.data[4] = double(4.0)
    check("median==3", numpy.median(m) == double(3.0), "mismatch")

    # percentile
    check("p50==3", approx_eq(numpy.percentile(m, double(50.0)), double(3.0)), "mismatch")

    a.delete()
    inv.delete()
    x.delete()
    y.delete()
    cr.delete()
    p.delete()
    m.delete()
    section_footer()


