from stdint import *
import t, c
import stdio
import string
import w32.win32console
import w32.win32memory
import testcheck

# TypeCastTest: type casts, zext/sext/trunc behavior,
# mixed signed/unsigned arithmetic and CDefine constants

# --- Test 1: CUInt8T -> CUInt32T zero extension (zext) ---
def test_zext_u8_u32():
    v: uint8 = 200  # 0xC8; sign-extension would yield 0xFFFFFFC8
    wide: uint32 = uint32(v)
    testcheck.check(wide == 200, "zext u8->u32 (200)", "zext u8->u32 (expected 200)")


# --- Test 2: CInt8T -> CInt32T sign extension (sext) ---
def test_sext_i8_i32():
    v: int8 = -50  # 0xCE
    wide: int32 = int32(v)
    testcheck.check(wide == -50, "sext i8->i32 (-50)", "sext i8->i32 (expected -50)")


# --- Test 3: CUInt32T -> CUInt64T zero extension ---
def test_zext_u32_u64():
    v: uint32 = 0x80000000  # top bit set
    wide: uint64 = uint64(v)
    testcheck.check(wide == 0x80000000, "zext u32->u64 (0x80000000)", "zext u32->u64 (expected 0x80000000)")


# --- Test 4: CInt32T -> CInt64T sign extension ---
def test_sext_i32_i64():
    v: int32 = -1  # 0xFFFFFFFF
    wide: int64 = int64(v)
    testcheck.check(wide == -1, "sext i32->i64 (-1)", "sext i32->i64 (expected -1)")


# --- Test 5: CUInt64T -> CUInt32T truncation (trunc) ---
def test_trunc_u64_u32():
    v: uint64 = 0x123456789ABCDEF0
    narrow: uint32 = uint32(v)
    testcheck.check(narrow == 0x9ABCDEF0, "trunc u64->u32 (0x9ABCDEF0)", "trunc u64->u32 (expected 0x9ABCDEF0)")


# --- Test 6: mixed signed/unsigned arithmetic ---
def test_mixed_signed_unsigned():
    a: int = -10
    b: uint32 = 20
    # In C mixed signed/unsigned ops convert the signed value to unsigned.
    # -10 as u32 is 0xFFFFFFF6; +20 overflows to 10.
    result: uint32 = uint32(a) + b
    stdio.printf("  mixed signed+unsigned: %u (C behavior: %u)\n", result, uint32(-10) + 20)
    testcheck.ok("mixed signed+unsigned (C behavior)")


# --- Test 7: CDefine constants in operations ---
define VAL_32BIT = 0x80000000
define VAL_NEG = -1
define VAL_BIG = 0xFFFFFFFF

def test_cdefine_values():
    """Verify CDefine constant values."""
    v1: uint32 = uint32(VAL_32BIT)
    v2: int = VAL_NEG
    v3: uint32 = uint32(VAL_BIG)
    stdio.printf("  CDefine: 0x80000000=%u, -1=%d, 0xFFFFFFFF=%u\n", v1, v2, v3)
    testcheck.ok("CDefine constants")


# --- Test 8: bit operations and type width ---
def test_bitops_width():
    """Verify bit operations keep the correct type width."""
    # Left shift
    v: uint32 = 1
    shifted: uint32 = v << 31  # should be 0x80000000
    testcheck.check(shifted == 0x80000000, "bit shift (1<<31 = 0x80000000)", "bit shift (expected 0x80000000)")

    # Right shift
    back: uint32 = shifted >> 31  # should be 1
    testcheck.check(back == 1, "bit shift (0x80000000>>31 = 1)", "bit shift (expected 1)")


# --- Test 9: integer div/mod (unsigned) ---
def test_unsigned_divmod():
    a: uint32 = 100
    b: uint32 = 7
    q: uint32 = a // b
    r: uint32 = a % b
    testcheck.check(q == 14 and r == 2, "unsigned div/mod (100//7=14, 100%7=2)", "unsigned div/mod (expected 14,2)")


# --- Test 10: integer div/mod (signed negative) ---
def test_signed_divmod_neg():
    a: int = -100
    b: int = 7
    q: int = a // b
    r: int = a % b
    # C: -100/7 = -14, -100%7 = -2; Python: -15 and 5.
    # TransPyC follows C semantics.
    stdio.printf("  signed div/mod: -100//7=%d, -100%%7=%d (C: -14,-2)\n", q, r)
    testcheck.ok("signed div/mod (C semantics)")


# --- Test 11: comparison operation results ---
def test_comparison_types():
    a: int = 10
    b: int = 20
    c_val: int = 10
    lt: int = 1 if a < b else 0
    eq: int = 1 if a == c_val else 0
    gt: int = 1 if b > a else 0
    testcheck.check(lt == 1 and eq == 1 and gt == 1, "comparison operations", "comparison operations failed")


# --- Test 12: pointer/integer casts ---
def test_ptr_int_cast():
    buf: uint32* = w32.win32memory.VirtualAlloc(None, 64, 0x3000, 0x04)
    if not buf:
        testcheck.fail("VirtualAlloc returned NULL")
        return
    # Pointer to integer
    addr: uint64 = uint64(buf)
    stdio.printf("  ptr->int: addr=0x%lx\n", addr)
    # Integer to pointer
    p2: uint32* = (uint32*)(addr)
    p2[0] = 0x12345678
    testcheck.check(buf[0] == 0x12345678, "ptr<->int roundtrip", "ptr<->int roundtrip failed")


# --- Test 13: CUInt64T multiplication ---
def test_u64_mul():
    a: uint64 = 1000
    b: uint64 = 1000
    c_val: uint64 = a * b
    testcheck.check(c_val == 1000000, "u64 mul (1000*1000=1000000)", "u64 mul (expected 1000000)")


# --- Test 14: bool operations (and/or) ---
def test_bool_ops():
    a: int = 5
    b: int = 0
    c_val: int = 3
    # Python and/or are short-circuiting
    r1: int = a and c_val  # 5 and 3 -> (5 && 3) = 1 in C
    r2: int = b or c_val   # 0 or 3 -> (0 || 3) = 1 in C
    stdio.printf("  bool: 5 and 3 = %d, 0 or 3 = %d (expect 1,1 in C)\n", r1, r2)
    testcheck.ok("bool ops (C semantics)")


# --- Test 15: conditional expression (ternary) ---
def test_ternary():
    a: int = 10
    b: int = 20
    max_val: int = a if a > b else b
    min_val: int = a if a < b else b
    testcheck.check(max_val == 20 and min_val == 10, "ternary (max=20 min=10)", "ternary (expected 20,10)")


def main() -> int | t.CExport:
    w32.win32console.SetConsoleCP(65001)
    w32.win32console.SetConsoleOutputCP(65001)

    testcheck.begin("TypeCastTest: 类型转换与运算基准测试")

    testcheck.section("zext/sext/trunc")
    test_zext_u8_u32()
    test_sext_i8_i32()
    test_zext_u32_u64()
    test_sext_i32_i64()
    test_trunc_u64_u32()

    testcheck.section("mixed operations")
    test_mixed_signed_unsigned()
    test_cdefine_values()
    test_bitops_width()

    testcheck.section("div/mod")
    test_unsigned_divmod()
    test_signed_divmod_neg()

    testcheck.section("comparison & logic")
    test_comparison_types()
    test_bool_ops()
    test_ternary()

    testcheck.section("pointer/int cast")
    test_ptr_int_cast()

    testcheck.section("u64 mul")
    test_u64_mul()

    return testcheck.end()
