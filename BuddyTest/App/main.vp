from stdint import *
import w32.win32console
import t, c
from t import CInt, CExport
import memhub
import mbuddytest


def main() -> CInt | CExport:
    w32.win32console.SetConsoleCP(65001)
    w32.win32console.SetConsoleOutputCP(65001)

    # BuddyTest has a negative case that deliberately double-frees. With memhub's
    # [MEMDBG] checks on (_memdbg_enable=1) the second free aborts, so disable it.
    memhub._memdbg_enable = 0

    return mbuddytest.mbuddy_main()
