import t


# Cross-module: single trailing default (mirrors write in includes/json/__writer.vp)
def one(x: int, cap: sizet = 4096) -> sizet:
    return cap


# Cross-module: 4 params, last has a default (same shape as json.write(pool, val, pretty, cap=4096))
def write(a: int, b: int, pretty: bool, cap: sizet = 4096) -> sizet:
    return cap


# Cross-module: multiple trailing defaults
def quad(a: int, b: int = 10, c: int = 20, d: int = 30) -> int:
    return a + b * 100 + c * 10000 + d * 1000000


# Cross-module: named / out-of-order args (add shape in wiki 04-functions.md)
def many(x: int, y: int, z: int = 1) -> int:
    return (x + y) * z
