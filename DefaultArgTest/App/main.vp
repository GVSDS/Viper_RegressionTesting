import stdio
import testcheck
import remote
import random


# Same module: single trailing default
def local_one(x: int, cap: sizet = 4096) -> sizet:
    return cap


# Same module: multiple trailing defaults
def local_quad(a: int, b: int = 10, c: int = 20, d: int = 30) -> int:
    return a + b * 100 + c * 10000 + d * 1000000


export def main() -> int:
    testcheck.begin("DefaultArgTest: default / named / out-of-order arguments")

    # Same-module defaults
    testcheck.section("same-module defaults")
    r1: sizet = local_one(1)
    testcheck.check(r1 == 4096, "local_one(1) cap = 4096", "local_one(1) cap != 4096")
    r2: int = local_quad(1)
    testcheck.check(r2 == 30201001, "local_quad(1) = 30201001", "local_quad(1) != 30201001")

    # Cross-module defaults
    testcheck.section("cross-module defaults")
    r3: sizet = remote.one(1)
    testcheck.check(r3 == 4096, "remote.one(1) cap = 4096", "remote.one(1) cap != 4096")
    r4: sizet = remote.write(1, 2, False)
    testcheck.check(r4 == 4096, "remote.write(1,2,False) cap = 4096", "remote.write(1,2,False) cap != 4096")

    # Explicit override
    testcheck.section("explicit override")
    r5: sizet = remote.one(1, 8)
    testcheck.check(r5 == 8, "remote.one(1,8) cap = 8", "remote.one(1,8) cap != 8")

    # Named / out-of-order arguments
    testcheck.section("named / out-of-order arguments")
    r6: sizet = remote.one(cap = 8, x = 1)
    testcheck.check(r6 == 8, "remote.one(cap = 8, x = 1) = 8", "remote.one(cap = 8, x = 1) != 8")
    r7: sizet = remote.one(x = 1, cap = 8)
    testcheck.check(r7 == 8, "remote.one(x = 1, cap = 8) = 8", "remote.one(x = 1, cap = 8) != 8")
    r8: sizet = remote.one(x = 1)
    testcheck.check(r8 == 4096, "remote.one(x = 1) cap = 4096", "remote.one(x = 1) cap != 4096")
    r9: int = remote.many(z = 3, x = 1, y = 2)
    testcheck.check(r9 == 9, "remote.many(z = 3, x = 1, y = 2) = 9", "remote.many(z = 3, x = 1, y = 2) != 9")

    # Multiple trailing defaults: pass only the leading ones
    testcheck.section("partial trailing defaults")
    r10: int = local_quad(1, 2)
    testcheck.check(r10 == 30200201, "local_quad(1,2) = 30200201", "local_quad(1,2) != 30200201")
    r11: int = remote.quad(1, 2)
    testcheck.check(r11 == 30200201, "remote.quad(1,2) = 30200201", "remote.quad(1,2) != 30200201")
    r12: int = local_quad(1, 2, 3)
    testcheck.check(r12 == 30030201, "local_quad(1,2,3) = 30030201", "local_quad(1,2,3) != 30030201")
    r13: int = remote.quad(1, 2, 3)
    testcheck.check(r13 == 30030201, "remote.quad(1,2,3) = 30030201", "remote.quad(1,2,3) != 30030201")
    r14: int = remote.quad(1)
    testcheck.check(r14 == 30201001, "remote.quad(1) = 30201001", "remote.quad(1) != 30201001")

    # Include-module (top-level .vp) defaults: vrandom.randrange(start, stop, step = 1)
    # stop-start==1 means width==1, so result is always start; unset step degrades to 0/garbage
    testcheck.section("include-module defaults")
    r15: int = random.randrange(5, 6)
    testcheck.check(r15 == 5, "vrandom.randrange(5,6) = 5 (step default)", "vrandom.randrange(5,6) != 5")

    return testcheck.end()
