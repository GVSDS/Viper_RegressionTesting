import t
from linkedlist import GSListNode

# Minimal repro: class name 'Value' collides with global variable name.
# GSListNode[Value] supplies Next; if the struct body is skipped, GEP overruns crash.

@t.NoVTable
class Value(GSListNode[Value]):
    Ty: t.CPtr
    Name: t.CPtr
    IsConst: int
    IntVal: int64
    FloatVal: double

    def __init__(self):
        self.Ty = None
        self.Name = None
        self.IsConst = 0
        self.IntVal = 0
        self.FloatVal = 0.0
        self.Next = None
