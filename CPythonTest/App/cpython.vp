extern def Py_FinalizeEx() -> int
extern def Py_IsInitialized() -> int


# ============================================================
# PyConfig
# ============================================================
class PySTATUS:
    func: const str
    err_msg: const str
    exitcode: int

class PyPreConfig:
    _config_version: int
    _config_init: int
    parse_argv: int
    isolated: int
    use_environment: int
    utf8_mode: int
    coerce_c_locale: int
    C_locale_warnings: int
    allocator: int
    dev_mode: int

class PyWideStringList:
    length: sizet
    items: t.CPtr

class PyConfig:
    _config_version: int
    _config_init: int
    isolated: int
    use_environment: int
    dev_mode: int
    install_signal_handlers: int
    use_hash_seed: int
    hash_seed: t.CUnsignedLong
    faulthandler: int
    tracemalloc: int
    import_time: int
    show_ref_count: int
    dump_refs: int
    dump_refs_file: const str
    malloc_stats: int
    filesystem_errors: int
    pycache_prefix: const str
    parse_argv: int
    argv: PyWideStringList
    program_name: const str
    xoptions: PyWideStringList
    warnoptions: PyWideStringList
    site_import: int
    bytes_warning: int
    warn_default_encoding: int
    inspect: int
    interactive: int
    optimization_level: int
    parser_debug: int
    verbose: int
    quiet: int
    home: const str
    pythonpath_env: const str
    module_search_paths: PyWideStringList
    module_search_paths_set: int
    executable: const str
    base_executable: const str
    prefix: const str
    base_prefix: const str
    exec_prefix: const str
    base_exec_prefix: const str
    platlibdir: const str
    stdio_filename: const str

extern def PyConfig_InitPythonConfig(config: PyConfig | t.CPtr)
extern def PyConfig_InitIsolatedConfig(config: PyConfig | t.CPtr)
extern def PyConfig_Clear(config: PyConfig | t.CPtr)
extern def PyConfig_Read(config: PyConfig | t.CPtr) -> PySTATUS
extern def Py_InitializeFromConfig(config: PyConfig | t.CPtr) -> PySTATUS
extern def Py_DecodeLocale(s: const str) -> str
extern def PyStatus_Exception(status: PySTATUS) -> int


