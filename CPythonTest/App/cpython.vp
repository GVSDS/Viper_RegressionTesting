# --- Type wrapper classes: operator overloading ---

# --- PyLongObj: Python integer wrapper ---
class PyLongObj:
    ptr: PyObject*

    def __new__(self) -> 'PyLongObj' | t.CPtr:
        return t.CPtr(malloc(PyLongObj.__sizeof__()))

    @staticmethod
    def from_long(val: t.CLong) -> 'PyLongObj' | t.CPtr:
        obj: PyLongObj* = PyLongObj()
        obj.ptr = PyLong_FromLong(val)
        return obj

    def __add__(self, other: PyLongObj*) -> 'PyLongObj' | t.CPtr:
        res: PyLongObj* = PyLongObj()
        res.ptr = PyNumber_Add(self.ptr, other.ptr)
        return res

    def __sub__(self, other: PyLongObj*) -> 'PyLongObj' | t.CPtr:
        res: PyLongObj* = PyLongObj()
        res.ptr = PyNumber_Subtract(self.ptr, other.ptr)
        return res

