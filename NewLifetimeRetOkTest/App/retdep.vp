from stdint import *


# =============================================================================
# A2（§14）`@life(ret(...))` 的被调方：五种返回值生命期契约各一条。
#
# 调用点（main.vp）**跨模块**取用 → 本文件的契约只能经 .vpi 行尾
# `# esc=… escn=… escr=…` 传递（本地契约表按文件重置，调用点必然查不到）。
# 设计与编码见 Debugger/ownership-and-new.md §14.3 / §14.3.1（GenApi.RET_KIND_*）。
# =============================================================================


# ret(heap)：自由生命期 → 结果可自由存进长命存储
@life(ret(heap))
def MkHeap() -> int*:
    return new heap hlife int


# ret(static)：指向静态存储（字符串常量）
@life(ret(static))
def MkStatic() -> char*:
    return "static-lit"


# ret(borrows=none)：返回值**不借用任何形参** → 非本帧
@life(ret(borrows=none))
def Fresh() -> int*:
    return new heap hlife int


# ret(frame)：返回值可能指向**本帧**存储 → 去向由调用点负责。
# 定义端对 `return <本帧存储>` 是**声明感知**的（§14.3.2）：声明成 frame（或
# `borrows=<该形参>`）即放行，否则 fail-fast —— 所以下面 `return l` 合法，
# 而"无声明的 return l"会被拒（见 root/EscapeTest）。
@life(ret(frame))
def FrameRet() -> int*:
    l: int* = new stack int
    return l


# ret(borrows=x)：返回值借用形参 x —— 调用点把结果当 x 的生命期。
# 配 `noescape(x)`：本函数只**借出** x、不把它存进长命存储，故形参 x 不算逃逸；
# 否则调用点会先在"实参逃逸"那条路径上拦下来，掩盖 ret 契约本身。
@life(noescape(x), ret(borrows=x))
def IdentBorrow(x: int*) -> int*:
    return x


# ret(borrows=<形参 1>)：借用**第 2 个**形参（不是第 1 个）。
# 用途：钉住"模块限定函数调用 `retdep.Identity2(...)` **不**含 self ⇒ 形参位=实参位"这一映射。
# 调用点故意让实参 0 是**本帧**指针、实参 1 是**堆**指针：映射正确 → 结果=堆（可存长命存储）；
# 若把模块限定函数误当方法而偏移一格 → 取成实参 0（本帧）→ 结果 FRAME → 调用点报错 ⇒ 用例失败。
@life(noescape(a, b), ret(borrows=1))
def Identity2(a: int*, b: int*) -> int*:
    return b
