from stdint import *
import zlib.pyzlib as pyzlib
import zlib.zdeflate as zdeflate
import zlib.zinflate as zinflate
import zlib.zdef as zdef
import string
import stdlib
import stdio
import testcheck
import t, c


def fill_data(data: BYTEPTR, size: t.CSizeT, seed: t.CSizeT, repeating: t.CInt):
    i: t.CSizeT
    for i in range(size):
        if repeating:
            data[i] = BYTE(65 + (i % 3))
        else:
            data[i] = BYTE((i * 31 + seed * 17 + (i * i) % 251) % 256)


def roundtrip(seed: t.CSizeT, size: t.CSizeT, repeating: t.CInt, wbits: t.CInt) -> t.CInt:
    data: BYTEPTR = BYTEPTR(stdlib.malloc(size))
    fill_data(data, size, seed, repeating)

    out_len: t.CSizeT = 0
    comp: BYTEPTR = pyzlib.compress(None, data, size,
                                    pyzlib.Z_DEFAULT_COMPRESSION, wbits, c.Addr(out_len))
    if not comp:
        testcheck.fail(f"seed={seed} size={size} rep={repeating} wbits={wbits}: "
                       f"compress 失败 err={pyzlib.get_error_code()} {pyzlib.get_error()}")
        stdlib.free(data)
        return -1

    dec_len: t.CSizeT = 0
    dec: BYTEPTR = pyzlib.decompress(None, comp, out_len, wbits,
                                     pyzlib.DEF_BUF_SIZE, c.Addr(dec_len))
    ok: t.CInt = 1
    if not dec:
        ok = 0
        testcheck.fail(f"seed={seed} size={size} rep={repeating} wbits={wbits}: "
                       f"decompress 失败 comp={out_len} err={pyzlib.get_error_code()} {pyzlib.get_error()}")
    elif dec_len != size or string.memcmp(dec, data, size) != 0:
        ok = 0
        testcheck.fail(f"seed={seed} size={size} rep={repeating} wbits={wbits}: "
                       f"内容不匹配 comp={out_len} dec={dec_len}")
    else:
        testcheck.ok(f"seed={seed} size={size} rep={repeating} wbits={wbits}: "
                     f"comp={out_len} dec={dec_len}")

    if dec: stdlib.free(dec)
    stdlib.free(comp)
    stdlib.free(data)
    return 0 if ok else -1


def main() -> t.CInt:
    testcheck.begin("ZlibDbg: zlib 多 seed/size/wbits 往返")

    testcheck.section("随机数据 (wbits=15)")
    sizes: t.CArray[t.CSizeT, None] = [250, 255, 256, 257, 260, 300, 500, 1000, 4096, 20000]
    n: t.CInt
    for n in range(10):
        roundtrip(t.CSizeT(n), sizes[n], 0, pyzlib.MAX_WBITS)

    testcheck.section("重复数据 (wbits=15)")
    sizes2: t.CArray[t.CSizeT, None] = [256, 257, 300, 1000, 20000]
    for n in range(5):
        roundtrip(t.CSizeT(n), sizes2[n], 1, pyzlib.MAX_WBITS)

    testcheck.section("gzip 容器 (wbits=31)")
    sizes3: t.CArray[t.CSizeT, None] = [300, 1000]
    for n in range(2):
        roundtrip(t.CSizeT(n), sizes3[n], 0, pyzlib.MAX_WBITS + 16)

    return testcheck.end()
