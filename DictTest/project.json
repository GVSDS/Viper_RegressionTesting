{
    "$schema": "https://raw.githubusercontent.com/TermiNexus/TransPyC/main/schemas/project-schema.json",
    "name": "DictTest",
    "version": "1.0.0",
    "source_dir": "./App",
    "build_dir": "./__vpcbuild__",
    "compiler": {
        "cmd": "llc",
        "flags": ["-filetype=obj", "-relocation-model=pic"]
    },
    "linker": {
        "cmd": "clang++",
        "flags": ["-lmsvcrt", "-lucrt", "-lpthread", "-lmingwex", "-lkernel32"],
        "output": "DictTest.exe"
    },
    "includes": [
        "../../includes"
    ],
    "target": {
        "triple": "x86_64-pc-windows-gnu",
        "datalayout": "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
    },
    "options": {
        "slice_level": 3,
        "sha1_slice_level": 1,
        "target": "llvm",
        "strict_mode": true
    }
}
